const SAFE_METHODS = new Set(['GET', 'HEAD', 'OPTIONS', 'TRACE']);

/**
 * Assert a status and fail with the response body, not just the code.
 * With no codes given, any 2xx passes.
 *
 * @param {import('@playwright/test').APIResponse} response
 * @param {...number} allowed
 */
export async function expectStatus(response, ...allowed) {
    const ok = allowed.length > 0 ? allowed.includes(response.status()) : response.ok();
    if (!ok) {
        const body = (await response.text()).slice(0, 600);
        throw new Error(
            `${response.url()} -> ${response.status()} ${response.statusText()}, ` +
            `expected ${allowed.length ? allowed.join('/') : '2xx'}. Body: ${body}`,
        );
    }
    return response;
}

/**
 * One browser-equivalent session. Each instance owns an isolated cookie jar,
 * so several users can be logged in at the same time - which the org tests
 * need (an OWNER setting a cap while a MEMBER watches their balance change).
 *
 * Two things the SPA does that a bare context does not:
 *
 * 1. The JWT arrives as an HttpOnly `jwt` cookie from POST
 *    `/api/public/auth/login` and just has to ride along. The cookie jar does
 *    that for free.
 * 2. CSRF. SecurityConfiguration installs CookieCsrfTokenRepository
 *    `.withHttpOnlyFalse()` with the request-attribute name set to null, which
 *    loads the token eagerly on *every* request - including public ones. So
 *    the XSRF-TOKEN cookie exists after the first call and must be echoed in
 *    X-XSRF-TOKEN on anything that is not a safe method. Miss it and you get a
 *    403 that looks exactly like an authorisation failure.
 */
export class NaploApi {
    email = '';

    /** @param {import('@playwright/test').APIRequestContext} ctx */
    constructor(ctx) {
        this.ctx = ctx;
    }

    async #withCsrf(method, headers) {
        if (SAFE_METHODS.has(method)) return headers;
        const cookies = await this.ctx.storageState();
        const token = cookies.cookies.find((cookie) => cookie.name === 'XSRF-TOKEN')?.value;
        return token ? { 'X-XSRF-TOKEN': token, ...headers } : headers;
    }

    get(url, options = {}) {
        return this.ctx.get(url, options);
    }

    async post(url, options = {}) {
        return this.ctx.post(url, { ...options, headers: await this.#withCsrf('POST', options.headers) });
    }

    async put(url, options = {}) {
        return this.ctx.put(url, { ...options, headers: await this.#withCsrf('PUT', options.headers) });
    }

    async patch(url, options = {}) {
        return this.ctx.patch(url, {
            ...options,
            headers: await this.#withCsrf('PATCH', options.headers),
        });
    }

    async delete(url, options = {}) {
        return this.ctx.delete(url, {
            ...options,
            headers: await this.#withCsrf('DELETE', options.headers),
        });
    }

    /** Await + status assertion + JSON decode, the shape most calls want. */
    async json(response, ...allowed) {
        const resolved = await response;
        await expectStatus(resolved, ...allowed);
        return resolved.json();
    }

    /** Seeds the XSRF-TOKEN cookie without changing any state. */
    async primeCsrf() {
        await this.get('/api/public/legal/versions');
    }

    // -- flows --

    /*
     * nginx caps /api/public/register at 2r/s (burst 3) and /api/public/auth/
     * at 2r/s (burst 5) per IP. Every worker in the suite shares one source
     * address, so a parallel run legitimately trips both. Retrying only on 503
     * keeps that infrastructure limit from reading as a product failure, while a
     * real 4xx still surfaces immediately.
     */
    async #retryOn503(send) {
        let response;
        for (let attempt = 0; attempt < 6; attempt++) {
            response = await send();
            if (response.status() !== 503) return response;
            await new Promise((resolve) => setTimeout(resolve, 600 + attempt * 400));
        }
        return response;
    }

    async register(email, password, legal) {
        await this.primeCsrf();
        this.email = email;

        return this.#retryOn503(() =>
            this.post('/api/public/register', {
                data: {
                    email,
                    password,
                    termsAcceptedVersion: legal.termsVersion,
                    privacyAcceptedVersion: legal.privacyVersion,
                    signupSource: 'e2e',
                },
            }),
        );
    }

    verifyEmail(token) {
        return this.get('/api/public/verify-email', { params: { token } });
    }

    login(email, password) {
        this.email = email;
        // Retried for the same reason as register: createAccount asserts a hard 200
        // here, so an unretried proxy 503 would fail every spec that needs a user.
        return this.#retryOn503(() =>
            this.post('/api/public/auth/login', { data: { email, password } }),
        );
    }

    logout() {
        return this.post('/api/public/auth/logout');
    }

    // -- convenience reads --

    me() {
        return this.json(this.get('/api/v1/user'), 200);
    }

    organizations() {
        return this.json(this.get('/api/v1/organizations'), 200);
    }

    /**
     * The org on the current JWT. callerRole is only populated for orgs the
     * caller belongs to, and a fresh account has exactly one - its personal org.
     * Once a user belongs to several, activate first and re-read.
     */
    async activeOrg() {
        const orgs = await this.organizations();
        if (orgs.length === 0) throw new Error(`${this.email} belongs to no organizations`);
        return orgs[0];
    }

    activate(orgId) {
        return this.json(this.post(`/api/v1/organizations/${orgId}/activate`), 200);
    }

    /**
     * Wallet balance. Pass `orgId` once the user belongs to more than one org -
     * the default reads `organizations()[0]`, which is whatever Mongo returns
     * first and is only unambiguous for a single-org account.
     */
    async balance(orgId) {
        const orgs = await this.organizations();
        const org = orgId ? orgs.find((o) => o.id === orgId) : orgs[0];
        if (!org) throw new Error(`${this.email} has no organization ${orgId ?? '[0]'}`);
        return Number(org.wallet.amount);
    }
}

const TOKEN_IN_QUERY = /[?&]token=([A-Za-z0-9._~%-]+)/;
const TOKEN_IN_PATH = /\/invite\/([A-Za-z0-9._~%-]+)/;

/**
 * Pull a one-time token out of an email body.
 *
 * EmailService builds `{baseUrl}/verify?token=`, `{baseUrl}/reset-password?token=`,
 * `{baseUrl}/email-change/confirm/token=` and - the odd one out -
 * `{baseUrl}/invite/{token}` as a path segment.
 */
export function extractToken(body, { inPath = false } = {}) {
    const match = (inPath ? TOKEN_IN_PATH : TOKEN_IN_QUERY).exec(body);
    if (!match) throw new Error(`no token found in email body: ${body.slice(0, 600)}`);
    return match[1];
}

/** Parse an SSE body into `{ event, data }` frames. */
export function sseEvents(body) {
    return body
        .split(/\r?\n\r?\n/)
        .filter((block) => block.trim().length > 0)
        .map((block) => {
            let event = 'message';
            const data = [];
            for (const line of block.split(/\r?\n/)) {
                if (line.startsWith('event:')) event = line.slice(6).trim();
                else if (line.startsWith('data:')) data.push(line.slice(5).replace(/^ /, ''));
            }
            return { event, data: data.join('\n') };
        });
}

/**
 * Wait on an asynchronous backend pipeline.
 *
 * Transcription, summary and title all run on @Async listeners after the
 * triggering request has already returned, so there is nothing to await -
 * polling the read model is what the SPA does too.
 *
 * The default sits under Playwright's 90s test timeout on purpose: a longer one
 * dies as an opaque Playwright timeout instead of the message below. A test
 * that genuinely needs more must pass `timeoutMs` AND call `test.slow()`.
 */
export async function pollUntil(
    probe,
    done,
    { timeoutMs = 60_000, intervalMs = 2_000, what = 'condition' } = {},
) {
    // `pollUntil(api.balance(), ...)` reads fine but passes a Promise, and the
    // resulting "probe is not a function" points here rather than at the caller.
    for (const [name, fn] of [['probe', probe], ['done', done]]) {
        if (typeof fn !== 'function') {
            throw new TypeError(
                `pollUntil(probe, done, options): ${name} must be a function, got ${
                    fn instanceof Promise ? 'a Promise' : typeof fn
                }. Pass a thunk - () => api.balance(), not api.balance().`,
            );
        }
    }

    const deadline = Date.now() + timeoutMs;
    let latest;
    while (Date.now() < deadline) {
        latest = await probe();
        if (done(latest)) return latest;
        await new Promise((resolve) => setTimeout(resolve, intervalMs));
    }
    throw new Error(
        `timed out after ${timeoutMs}ms waiting for ${what}. Last seen: ${JSON.stringify(latest)?.slice(0, 400)}`,
    );
}

