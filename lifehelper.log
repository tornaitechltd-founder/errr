import { test, expect, expectStatus } from '../../support/fixtures.js';
import { fundedOrgWithMember } from '../../support/org.js';
import { appendSlice, createRecording, TRANSCRIPT } from '../../support/recordings.js';

/**
 * Two reps, one client. Rep B picks up the call Rep A started and needs to
 * know where it left off.
 *
 * The money assertions are the point, as they were for the personal briefing:
 * * a team briefing that billed per reader would be a worse deal than no
 * sharing at all.
 */
const enableSharing = (owner, orgId, on = true) =>
    owner.api.json(owner.api.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
        data: { contactHistoryVisibleToPeers: on },
    }), 200);

const createContact = (api, name) =>
    api.json(api.post('/api/v1/contacts', { data: { name } }), 200);

const brief = (api, speakerId) =>
    api.json(api.get(`/api/v1/speakers/${speakerId}/brief`), 200);

const spentByCaller = async (who, orgId) =>
    Number((await who.api.json(who.api.get(`/api/v1/organizations/${orgId}`), 200))
        .callersSpentThisPeriodUsd);

/**
 * A summarised call with a shared contact, owned by whoever api is.
 *
 * @returns that user's own speaker id for the contact - the thing their
 * briefing is requested by.
 */
async function callWith(api, contactId, title) {
    const { id } = await createRecording(api, 'E2E group', title);
    await expectStatus(await appendSlice(api, id, `${TRANSCRIPT} `), 200);
    await expectStatus(await api.post(`/api/v1/recordings/${id}/summary`), 200);
    const tagged = await api.json(api.patch(`/api/v1/recordings/${id}/participants`, {
        data: { contactIds: [contactId], oneOnOne: true },
    }), 200);
    return tagged.participantIds[0];
}

test.describe('Diarization > Team briefing', () => {
    test('the briefing pools the whole team and says whose call was whose',
        async ({ createAccount, mailpit }) => {
            test.slow();
            const { owner, member, orgId } = await fundedOrgWithMember(createAccount, mailpit);
            await enableSharing(owner, orgId);
            const john = await createContact(owner.api, 'John Casson');

            const memberSpeaker = await callWith(member.api, john.id, 'Follow-up call');
            // Owner's call last, so it is the newest conversation and leads the
            // prompt - which is what makes the attribution assertion below bite.
            await callWith(owner.api, john.id, 'Discovery call');

            const result = await brief(member.api, memberSpeaker);
            expect(result.sourceCount).toBe(2);

            // The stub echoes the first source header it was handed. A shared
            // briefing that did not mark a colleague's call would tell the
            // reader "you agreed to send the contract" about a conversation
            // they were never on.
            expect(result.brief).toContain('call, not yours');
        });

    test('whoever opens it first pays, and the rest of the team reads it free',
        async ({ createAccount, mailpit }) => {
            test.slow();
            const { owner, member, orgId } = await fundedOrgWithMember(createAccount, mailpit);
            await enableSharing(owner, orgId);
            const john = await createContact(owner.api, 'John Casson');

            const ownerSpeaker = await callWith(owner.api, john.id, 'Discovery call');
            const memberSpeaker = await callWith(member.api, john.id, 'Follow-up call');

            const first = await brief(owner.api, ownerSpeaker);
            expect(first.cached).toBe(false);
            expect(first.sourceCount).toBe(2);

            const walletBefore = await spentByCaller(member, orgId);
            const second = await brief(member.api, memberSpeaker);

            // One briefing per contact, not per reader - a handover the second
            // rep has to pay for is a handover they will skip.
            expect(second.cached).toBe(true);
            expect(second.brief).toBe(first.brief);
            expect(await spentByCaller(member, orgId)).toBeCloseTo(walletBefore, 6);
        });

    test('the person who asked is the one billed', async ({ createAccount, mailpit }) => {
        test.slow();
        const { owner, member, orgId } = await fundedOrgWithMember(createAccount, mailpit);
        await enableSharing(owner, orgId);
        const john = await createContact(owner.api, 'John Casson');

        await callWith(member.api, john.id, 'Follow-up call');
        // Owner's call is newest, so the ledger row is anchored on a recording
        // the member does not own.
        await callWith(owner.api, john.id, 'Discovery call');
        const memberSpeaker = (await member.api.json(await member.api.get('/api/v1/speakers'), 200))
            .find((s) => s.contactId === john.id).id;

        const ownerBefore = await spentByCaller(owner, orgId);
        const memberBefore = await spentByCaller(member, orgId);

        await brief(member.api, memberSpeaker);

        // Attributing this to the anchor recording's owner would bill a
        // colleague for someone else's question and burn their spend cap.
        expect(await spentByCaller(owner, orgId)).toBeGreaterThan(ownerBefore);
        expect(await spentByCaller(member, orgId)).toBeCloseTo(memberBefore, 6);
    });

    test('switching sharing off falls back to your own history',
        async ({ createAccount, mailpit }) => {
            test.slow();
            const { owner, member, orgId } = await fundedOrgWithMember(createAccount, mailpit);
            await enableSharing(owner, orgId);
            const john = await createContact(owner.api, 'John Casson');

            const memberSpeaker = await callWith(member.api, john.id, 'Follow-up call');
            await callWith(owner.api, john.id, 'Discovery call');
            expect((await brief(member.api, memberSpeaker)).sourceCount).toBe(2);

            await enableSharing(owner, orgId, false);

            // The link survives, but the org no longer pools - so the briefing
            // is built from this member's own calls and nobody else's.
            const solo = await brief(member.api, memberSpeaker);
            expect(solo.sourceCount).toBe(1);
        });
});
