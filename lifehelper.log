import { test, expect, expectStatus } from '../../support/fixtures.js';
import { TRANSCRIPT, appendSlice, createRecording } from '../../support/recordings.js';
import { membershipId, orgWithMember } from '../../support/org.js';

/**
 * RecordingPermissionValidator.assertFullAccess, end to end. Three outcomes,
 * and the status code is the tell:
 *
 * - creator                  -> 200
 * - caller with no membership in
 *   the recording's org     -> 404, via requireMemberOr404, so a
 *                              tenant boundary never leaks the fact
 *                              that the recording exists
 * - peer MEMBER of the same org -> 403 "You do not have access"
 * - OWNER/ADMIN, toggle off  -> 403 "requires enabling ..."
 * - OWNER/ADMIN, toggle on   -> 200, transcript included
 */
const detailsOf = (api, id) => api.json(api.get(`/api/v1/recordings/${id}`), 200);

/** The single-recording patches a raw text body, not JSON. */
const AS_TEXT = { 'Content-Type': 'text/plain' };

const setTranscriptVisibility = async (owner, orgId, value) =>
  expectStatus(
    await owner.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
      data: { transcriptsVisibleToAdmins: value },
    }),
    200,
  );

/** Every read/write the controller guards behind assertFullAccess. */
const guardedCalls = (api, id) => [
  ['GET details', () => api.get(`/api/v1/recordings/${id}`)],
  ['GET audio url', () => api.get(`/api/v1/recordings/${id}/audio`)],
  ['GET audio stream', () => api.get(`/api/v1/recordings/${id}/audio/stream`)],
  ['PATCH title', () => api.patch(`/api/v1/recordings/${id}/title`, { data: 'x', headers: AS_TEXT })],
  ['PATCH group', () => api.patch(`/api/v1/recordings/${id}/group`, { data: 'x', headers: AS_TEXT })],
  [
    'PATCH transcript',
    () => api.patch(`/api/v1/recordings/${id}/transcript`, { data: 'x', headers: AS_TEXT }),
  ],
  ['POST summary', () => api.post(`/api/v1/recordings/${id}/summary`)],
  ['POST generate-title', () => api.post(`/api/v1/recordings/${id}/generate-title`)],
  ['POST live-finalize', () => api.post(`/api/v1/recordings/${id}/live-finalize`)],
  ['POST restore', () => api.post(`/api/v1/recordings/${id}/restore`)],
  ['DELETE', () => api.delete(`/api/v1/recordings/${id}`)],
  ['DELETE forever', () => api.delete(`/api/v1/recordings/${id}/forever`)],
];

test.describe('Recording > Permissions', () => {
  test('a caller outside the recordings org gets 404 everywhere', async ({ newUser }) => {
    const owner = await newUser('recorder');
    const { id } = await createRecording(owner, 'Owner group', 'Owner title');
    await expectStatus(await appendSlice(owner, id, `${TRANSCRIPT} `), 200);

    const stranger = await newUser('stranger');
    for (const [label, call] of guardedCalls(stranger, id)) {
      const refused = await call();
      expect(refused.status(), `${label} must not leak across tenants`).toBe(404);
      expect((await refused.json()).message).toBe('Not found.');
    }

    // Untouched for its owner.
    const after = await detailsOf(owner, id);
    expect(after.title).toBe('Owner title');
    expect(after.group).toBe('Owner group');
    expect(after.transcript).toContain(TRANSCRIPT);
  });

  test('a peer MEMBER is refused every read and every mutation', async ({
    createAccount,
    mailpit,
  }) => {
    const { owner, member, orgId } = await orgWithMember(
      createAccount,
      mailpit,
      'Naplo E2E Peer Read',
    );
    const { id } = await createRecording(owner.api, 'Owner group', 'Owner title');
    await expectStatus(await appendSlice(owner.api, id, `${TRANSCRIPT} `), 200);

    // Sharing an employer is not a reason to read - or retitle, or delete -
    // a colleague's recording, and the toggle below never applies to a plain
    // MEMBER. 403 not 404: the membership exists, the access does not.
    for (const [label, call] of guardedCalls(member.api, id)) {
      const refused = await call();
      expect(refused.status(), `${label} must be refused for a peer MEMBER`).toBe(403);
      expect((await refused.json()).message).toBe('You do not have access to this recording');
    }

    await setTranscriptVisibility(owner.api, orgId, true);
    const stillRefused = await member.api.get(`/api/v1/recordings/${id}`);
    expect(stillRefused.status()).toBe(403);

    // And the peer's own dashboard never widens either.
    expect(await member.api.json(member.api.get('/api/v1/recordings'), 200)).toHaveLength(0);

    // Every mutation above ran through assertFullAccess before touching Mongo,
    // so the owner's copy is byte-identical to what they left.
    const after = await detailsOf(owner.api, id);
    expect(after.title).toBe('Owner title');
    expect(after.group).toBe('Owner group');
    expect(after.transcript).toContain(TRANSCRIPT);
    expect(after.deletedAt).toBeNull();
  });

  test('an OWNER is refused the transcript while the toggle is off', async ({
    createAccount,
    mailpit,
  }) => {
    const { owner, member, orgId } = await orgWithMember(
      createAccount,
      mailpit,
      'Naplo E2E Admin Gate',
    );
    const { id } = await createRecording(member.api, 'Member group', 'Member title');
    await expectStatus(await appendSlice(member.api, id, `${TRANSCRIPT} `), 200);

    const refused = await owner.api.get(`/api/v1/recordings/${id}`);
    expect(refused.status()).toBe(403);
    expect((await refused.json()).message).toContain('Transcripts visible to admins');
    expect((await owner.api.get(`/api/v1/recordings/${id}/audio/stream`)).status()).toBe(403);

    // The member's recording is invisible on the owner's dashboard too -
    // canSeePeerRecordings needs the same opt-in.
    const listed = await owner.api.json(owner.api.get('/api/v1/recordings'), 200);
    expect(listed.map((row) => row.id)).not.toContain(id);

    // Metadata is still fair game: the spend report reads through
    // canReadMetadata, which the toggle does not gate.
    const targetMembership = await membershipId(owner.api, orgId, member.email);
    const usage = await owner.api.json(
      owner.api.get(`/api/v1/organizations/${orgId}/members/${targetMembership}/usage`),
      200,
    );
    const reported = usage.recentRecordings.find((row) => row.id === id);
    expect(reported.title).toBe('Member title');
    expect(reported.transcript).toBeUndefined();
  });

  test('an OWNER reads the transcript once the org opts in', async ({ createAccount, mailpit }) => {
    const { owner, member, orgId } = await orgWithMember(
      createAccount,
      mailpit,
      'Naplo E2E Admin Opt In',
    );
    const { id } = await createRecording(member.api, 'Member group', 'Member title');
    await expectStatus(await appendSlice(member.api, id, `${TRANSCRIPT} `), 200);

    await setTranscriptVisibility(owner.api, orgId, true);

    const seen = await detailsOf(owner.api, id);
    expect(seen.id).toBe(id);
    expect(seen.title).toBe('Member title');
    expect(seen.transcript).toContain(TRANSCRIPT);
  });

  test('the opted-in listing sideloads creator identity onto peer rows only', async ({
    createAccount,
    mailpit,
  }) => {
    const { owner, member, orgId } = await orgWithMember(
      createAccount,
      mailpit,
      'Naplo E2E Admin Listing',
    );
    const { id: memberRecording } = await createRecording(member.api, 'Member group', 'By member');
    const { id: ownRecording } = await createRecording(owner.api, 'Owner group', 'By owner');

    await setTranscriptVisibility(owner.api, orgId, true);

    const listed = await owner.api.json(owner.api.get('/api/v1/recordings'), 200);
    expect(listed.map((row) => row.id).sort()).toEqual([memberRecording, ownRecording].sort());

    const peerRow = listed.find((row) => row.id === memberRecording);
    // Sideloaded so the SPA can render a "by Alice" byline without a second fetch.
    expect(peerRow.creatorEmail).toBe(member.email);
    expect(peerRow.creatorId).toBeTruthy();

    const ownRow = listed.find((row) => row.id === ownRecording);
    // Nulled on the caller's own rows - that absence is how the SPA tells
    // "mine" from "theirs".
    expect(ownRow.creatorEmail).toBeNull();
    expect(ownRow.creatorId).toBeTruthy();
    expect(ownRow.creatorId).not.toBe(peerRow.creatorId);
  });

  test('an ADMIN gets the same access an OWNER does', async ({ createAccount, mailpit }) => {
    const { owner, member, orgId } = await orgWithMember(
      createAccount,
      mailpit,
      'Naplo E2E Admin Role',
    );
    const { id } = await createRecording(owner.api, 'Owner group', 'Owner title');
    await expectStatus(await appendSlice(owner.api, id, `${TRANSCRIPT} `), 200);

    const targetMembership = await membershipId(owner.api, orgId, member.email);
    await expectStatus(
      await owner.api.put(`/api/v1/organizations/${orgId}/members/${targetMembership}/role`, {
        data: { role: 'ADMIN' },
      }),
      200,
    );

    // hasAtLeast(ADMIN), so promotion alone lifts the 403 to the toggle gate.
    const stillGated = await member.api.get(`/api/v1/recordings/${id}`);
    expect(stillGated.status()).toBe(403);

    await setTranscriptVisibility(owner.api, orgId, true);
    // The role is read from Mongo on every call, so no re-login is needed.
    expect((await detailsOf(member.api, id)).transcript).toContain(TRANSCRIPT);
  });

  test('a peer cannot delete the recording', async ({ newUser }) => {
    const owner = await newUser('recorder');
    const { id } = await createRecording(owner);

    const stranger = await newUser('stranger');
    expect((await stranger.delete(`/api/v1/recordings/${id}`)).status()).toBe(404);
    expect((await owner.get(`/api/v1/recordings/${id}`)).status()).toBe(200);
  });
});
