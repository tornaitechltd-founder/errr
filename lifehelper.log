import { test, expect, expectStatus, extractToken } from '../../support/fixtures.js';
import { orgWithMember } from '../../support/org.js';

/**
 * A business org owned by `api` and made active, without the invite round trip.
 *
 * The name is suffixed per call because `OrganizationService.saveWithUniqueSlug`
 * gives up after MAX_SLUG_ATTEMPTS (25) collisions on one slug root - a literal
 * name breaks setup once a kept database has accumulated 25 of them.
 */
async function ownedBusinessOrg(api, base) {
    const name = `${base} ${Date.now().toString(36)}${Math.random().toString(36).slice(2, 7)}`;
    // createBusinessOrganization is an unconditional HttpStatus.CREATED.
    const org = await api.json(api.post('/api/v1/organizations', { data: { name } }), 201);
    await api.activate(org.id);
    return { orgId: org.id, name };
}

/** Issue an invite and hand back both the DTO and the token that only the email carries. */
async function invite(owner, mailpit, orgId, email, role = 'MEMBER') {
    const invitation = await owner.json(
        owner.post(`/api/v1/organizations/${orgId}/invitations`, { data: { email, role } }),
        201,
    );
    const body = await mailpit.waitFor(email, 'invited to join');
    return { invitation, token: extractToken(body, { inPath: true }) };
}

test.describe('Organization > Promotion', () => {
    test('a personal org becomes a business', async ({ newUser }) => {
        const solo = await newUser('solo');
        const personalId = (await solo.activeOrg()).id;

        const promoted = await solo.json(
            solo.post(`/api/v1/organizations/${personalId}/promote`, {
                data: {
                    businessName: 'Naplo E2E Promoted Ltd',
                    taxId: 'GB123456789',
                    taxIdType: 'VAT',
                },
            }),
            200,
        );

        expect(promoted.id).toBe(personalId);
        expect(promoted.type).toBe('BUSINESS');
        expect(promoted.businessName).toBe('Naplo E2E Promoted Ltd');
        expect(promoted.taxId).toBe('GB123456789');
        expect(promoted.taxIdType).toBe('VAT');
        expect(promoted.callerRole).toBe('OWNER');

        const reread = await solo.json(solo.get(`/api/v1/organizations/${personalId}`), 200);
        expect(reread.type).toBe('BUSINESS');
        expect(reread.businessName).toBe('Naplo E2E Promoted Ltd');
    });

    test('a business org cannot be promoted again', async ({ newUser }) => {
        const owner = await newUser('owner');
        const { orgId, name } = await ownedBusinessOrg(owner.api, 'Naplo E2E Already Inc');

        const refused = await owner.post(`/api/v1/organizations/${orgId}/promote`, {
            data: { businessName: name },
        });
        expect(refused.status()).toBe(409);

        // promoteToBusiness throws before touching the document, so nothing partial landed.
        const unchanged = await owner.json(owner.get(`/api/v1/organizations/${orgId}`), 200);
        expect(unchanged.businessName ?? null).toBeNull();
    });

    test('promotion requires a business name', async ({ newUser }) => {
        const solo = await newUser('solo');
        const personalId = (await solo.activeOrg()).id;

        const refused = await solo.post(`/api/v1/organizations/${personalId}/promote`, {
            data: { businessName: '   ', taxId: 'GB123456789' },
        });
        expect(refused.status()).toBe(400);

        const unchanged = await solo.json(solo.get(`/api/v1/organizations/${personalId}`), 200);
        expect(unchanged.type).toBe('PERSONAL');
    });

    test('a member cannot promote the org they were invited to', async ({
                                                                            createAccount,
                                                                            mailpit,
                                                                        }) => {
        const { member, orgId } = await orgWithMember(createAccount, mailpit, 'Naplo E2E Promote Guard');

        const refused = await member.api.post(`/api/v1/organizations/${orgId}/promote`, {
            data: { businessName: 'Member Takeover Ltd' },
        });
        expect(refused.status()).toBe(403);
    });
});

test.describe('Organization > Enforcement settings', () => {
    test('the owner flips a single toggle', async ({ newUser }) => {
        const owner = await newUser('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Policy');

        // Organization's @Builder.Default values: false, then three trues.
        const before = await owner.json(owner.get(`/api/v1/organizations/${orgId}`), 200);
        expect(before.transcriptsVisibleToAdmins).toBe(false);
        expect(before.employeesCanCreateSideOrgs).toBe(true);
        expect(before.employeesCanJoinOtherOrgs).toBe(true);
        expect(before.employeesCanExportRecordings).toBe(true);

        const updated = await owner.json(
            owner.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
                data: { transcriptsVisibleToAdmins: true },
            }),
            200,
        );

        expect(updated.transcriptsVisibleToAdmins).toBe(true);
        expect(updated.employeesCanCreateSideOrgs).toBe(true);
        expect(updated.employeesCanJoinOtherOrgs).toBe(true);
        expect(updated.employeesCanExportRecordings).toBe(true);

        const reread = await owner.json(owner.get(`/api/v1/organizations/${orgId}`), 200);
        expect(reread.transcriptsVisibleToAdmins).toBe(true);
        expect(reread.employeesCanCreateSideOrgs).toBe(true);
        expect(reread.employeesCanJoinOtherOrgs).toBe(true);
        expect(reread.employeesCanExportRecordings).toBe(true);
    });

    test('an omitted field is left alone', async ({ newUser }) => {
        const owner = await newUser('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Partial Policy');

        await expectStatus(
            await owner.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
                data: { transcriptsVisibleToAdmins: true, employeesCanExportRecordings: false },
            }),
            200,
        );

        // The SPA puts one switch at a time, so a null field must not reset its neighbours.
        const second = await owner.json(
            owner.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
                data: { employeesCanJoinOtherOrgs: false },
            }),
            200,
        );
        expect(second.transcriptsVisibleToAdmins).toBe(true);
        expect(second.employeesCanCreateSideOrgs).toBe(true);
        expect(second.employeesCanJoinOtherOrgs).toBe(false);
        expect(second.employeesCanExportRecordings).toBe(false);

        const reread = await owner.json(owner.get(`/api/v1/organizations/${orgId}`), 200);
        expect(reread.transcriptsVisibleToAdmins).toBe(true);
        expect(reread.employeesCanCreateSideOrgs).toBe(true);
        expect(reread.employeesCanJoinOtherOrgs).toBe(false);
        expect(reread.employeesCanExportRecordings).toBe(false);
    });

    test('a member cannot change enforcement settings', async ({ createAccount, mailpit }) => {
        const { owner, member, orgId } = await orgWithMember(
            createAccount,
            mailpit,
            'Naplo E2E Policy Guard',
        );
        await expectStatus(
            await owner.api.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
                data: { employeesCanExportRecordings: false },
            }),
            200,
        );

        const refused = await member.api.put(`/api/v1/organizations/${orgId}/enforcement-settings`, {
            data: { employeesCanExportRecordings: true },
        });
        expect(refused.status()).toBe(403);

        // The guard runs before OrganizationService, so the owner's value must survive.
        const reread = await owner.api.json(owner.get(`/api/v1/organizations/${orgId}`), 200);
        expect(reread.employeesCanExportRecordings).toBe(false);
    });

    test('a personal org has no enforcement settings', async ({ newUser }) => {
        const solo = await newUser('solo');
        const personalId = (await solo.activeOrg()).id;

        const refused = await solo.put(`/api/v1/organizations/${personalId}/enforcement-settings`, {
            data: { transcriptsVisibleToAdmins: true },
        });
        expect(refused.status()).toBe(400);
    });
});

test.describe('Organization > Deletion', () => {
    test('the owner erases a business org', async ({ createAccount }) => {
        const owner = await createAccount('owner');
        const { orgId, name } = await ownedBusinessOrg(owner.api, 'Naplo E2E Doomed');

        const result = await owner.api.json(
            owner.api.delete(`/api/v1/organizations/${orgId}`, {
                // OrganizationDeletionService compares trim() + equalsIgnoreCase, not equals.
                data: { currentPassword: owner.password, confirmationName: `  ${name.toUpperCase()}  ` },
            }),
            200,
        );
        // A business org starts on `new Wallet()` ($0.00) and nothing was ever topped
        // up, so refundedWallet || short-circuits and Stripe is never called.
        expect(Number(result.refundedUSD)).toBe(0);

        expect((await owner.api.get(`/api/v1/organizations/${orgId}`)).status()).toBe(404);
        // 403, not 404: the membership row is gone, so requireMember refuses first.
        expect((await owner.api.get(`/api/v1/organizations/${orgId}/members`)).status()).toBe(403);
        expect((await owner.api.organizations()).map((org) => org.id)).not.toContain(orgId);
    });

    test('the confirmation name must match the letters', async ({ createAccount }) => {
        const owner = await createAccount('owner');
        const { orgId, name } = await ownedBusinessOrg(owner.api, 'Naplo E2E Typo Guard');

        const refused = await owner.api.delete(`/api/v1/organizations/${orgId}`, {
            data: { currentPassword: owner.password, confirmationName: name.replace('Guard', 'Gaurd') },
        });
        expect(refused.status()).toBe(400);

        await expectStatus(await owner.api.get(`/api/v1/organizations/${orgId}`), 200);
    });

    test('both confirmation fields are mandatory', async ({ createAccount }) => {
        const owner = await createAccount('owner');
        const { orgId, name } = await ownedBusinessOrg(owner.api, 'Naplo E2E Confirm Body');

        // DeleteOrganizationRequest is {@NotBlank currentPassword, @NotBlank confirmationName}.
        for (const body of [
            { currentPassword: owner.password },
            { confirmationName: name },
            { currentPassword: owner.password, confirmationName: '   ' },
            { currentPassword: '  ', confirmationName: name },
        ]) {
            const refused = await owner.api.delete(`/api/v1/organizations/${orgId}`, { data: body });
            expect(refused.status(), JSON.stringify(body)).toBe(400);
        }

        await expectStatus(await owner.api.get(`/api/v1/organizations/${orgId}`), 200);
    });

    test('the current password must match', async ({ createAccount }) => {
        const owner = await createAccount('owner');
        const { orgId, name } = await ownedBusinessOrg(owner.api, 'Naplo E2E Password Guard');

        const refused = await owner.api.delete(`/api/v1/organizations/${orgId}`, {
            data: {
                currentPassword: 'definitely-not-the-password-9',
                confirmationName: name,
            },
        });
        expect(refused.status()).toBe(400);

        await expectStatus(await owner.api.get(`/api/v1/organizations/${orgId}`), 200);
    });

    test('a personal org cannot be deleted through this endpoint', async ({ createAccount }) => {
        const solo = await createAccount('solo');
        const personal = await solo.api.activeOrg();

        const refused = await solo.api.delete(`/api/v1/organizations/${personal.id}`, {
            data: { currentPassword: solo.password, confirmationName: personal.name },
        });
        expect(refused.status()).toBe(403);

        await expectStatus(await solo.api.get(`/api/v1/organizations/${personal.id}`), 200);
    });
});

test.describe('Organization > Invitation administration', () => {
    test('a pending invitation is listed, then revoked', async ({
                                                                    createAccount,
                                                                    uniqueEmail,
                                                                }) => {
        const owner = await createAccount('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Invite Desk');
        const invitee = uniqueEmail('invitee');

        const invitation = await owner.api.json(
            owner.api.post(`/api/v1/organizations/${orgId}/invitations`, {
                data: { email: invitee, role: 'MEMBER' },
            }),
            201,
        );
        expect(invitation.email).toBe(invitee);
        expect(invitation.role).toBe('MEMBER');
        expect(invitation.orgId).toBe(orgId);
        // The redemption token is a bearer credential; it must only ever travel by email.
        expect(invitation.token).toBeUndefined();

        const pending = await owner.api.json(
            owner.api.get(`/api/v1/organizations/${orgId}/invitations`),
            200,
        );
        expect(pending.map((row) => row.id)).toContain(invitation.id);

        await expectStatus(
            await owner.api.delete(`/api/v1/organizations/${orgId}/invitations/${invitation.id}`),
            204,
        );
        await expectStatus(
            await owner.api.delete(`/api/v1/organizations/${orgId}/invitations/${invitation.id}`),
            204,
        );

        const after = await owner.api.json(
            owner.api.get(`/api/v1/organizations/${orgId}/invitations`),
            200,
        );
        expect(after.map((row) => row.id)).not.toContain(invitation.id);
    });

    test('a revoked invitation cannot be redeemed', async ({ createAccount, mailpit }) => {
        const owner = await createAccount('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Dead Link');
        const invitee = await createAccount('invitee');

        const { invitation, token } = await invite(owner.api, mailpit, orgId, invitee.email);
        await expectStatus(
            await owner.api.delete(`/api/v1/organizations/${orgId}/invitations/${invitation.id}`),
            204,
        );

        const refused = await invitee.api.post('/api/v1/organizations/invitations/accept', {
            data: { token },
        });
        expect(refused.status()).toBe(400);
        expect((await invitee.api.organizations()).map((org) => org.id)).not.toContain(orgId);
    });

    test('an accepted invitation can no longer be revoked', async ({ createAccount, mailpit }) => {
        const owner = await createAccount('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Late Revoke');
        const invitee = await createAccount('invitee');

        const { invitation, token } = await invite(owner.api, mailpit, orgId, invitee.email);
        // acceptInvitation is an unconditional HttpStatus.CREATED.
        await expectStatus(
            await invitee.api.post('/api/v1/organizations/invitations/accept', { data: { token } }),
            201,
        );

        const refused = await owner.api.delete(
            `/api/v1/organizations/${orgId}/invitations/${invitation.id}`,
        );
        expect(refused.status()).toBe(409);
    });

    test('a member can read pending invitations but cannot revoke them', async ({
            createAccount,
            mailpit,
            uniqueEmail,
        }) => {
        const { owner, member, orgId } = await orgWithMember(
            createAccount,
            mailpit,
            'Naplo E2E Invite Visibility',
        );

        const invitation = await owner.api.json(
            owner.api.post(`/api/v1/organizations/${orgId}/invitations`, {
                data: { email: uniqueEmail('nextup'), role: 'MEMBER' },
            }),
            201,
        );

        const pending = await member.api.json(
            member.api.get(`/api/v1/organizations/${orgId}/invitations`),
            200,
        );
        expect(pending.map((row) => row.id)).toContain(invitation.id);

        const refused = await member.api.delete(
            `/api/v1/organizations/${orgId}/invitations/${invitation.id}`,
        );
        expect(refused.status()).toBe(403);
    });

    test('a non-member cannot read pending invitations', async ({ newUser }) => {
        const owner = await newUser('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Invite Privacy');

        const stranger = await newUser('stranger');
        const refused = await stranger.get(`/api/v1/organizations/${orgId}/invitations`);
        expect(refused.status()).toBe(403);
    });

    test('the invitee declines and the slot frees up', async ({ createAccount, mailpit }) => {
        const owner = await createAccount('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Declined');
        const invitee = await createAccount('invitee');

        const { invitation, token } = await invite(owner.api, mailpit, orgId, invitee.email);

        const listBefore = await owner.api.json(
            owner.api.get(`/api/v1/organizations/${orgId}/invitations`),
            200,
        );
        expect(listBefore.map((row) => row.id)).toContain(invitation.id);

        const declined = await invitee.api.json(
            invitee.api.post('/api/v1/organizations/invitations/decline', { data: { token } }),
            200,
        );
        expect(declined.status).toBe('declined');
        expect(declined.message).toBe('Invitation declined.');

        // decline() returns early once revokedAt is stamped, so a repeat is a 200 no-op.
        await expectStatus(
            await invitee.api.post('/api/v1/organizations/invitations/decline', { data: { token } }),
            200,
        );

        const pending = await owner.api.json(
            owner.api.get(`/api/v1/organizations/${orgId}/invitations`),
            200,
        );
        expect(pending.map((row) => row.id)).not.toContain(invitation.id);

        // A declined row stamps revokedAt, so accept() refuses with "Invitation has been revoked."
        const tooLate = await invitee.api.post('/api/v1/organizations/invitations/accept', {
            data: { token },
        });
        expect(tooLate.status()).toBe(400);
        expect((await invitee.api.organizations()).map((org) => org.id)).not.toContain(orgId);
    });

    test('only the addressee can decline', async ({ createAccount, mailpit, uniqueEmail }) => {
        const owner = await createAccount('owner');
        const { orgId } = await ownedBusinessOrg(owner.api, 'Naplo E2E Decline Guard');

        const { invitation, token } = await invite(owner.api, mailpit, orgId, uniqueEmail('addressee'));
        const bystander = await createAccount('bystander');

        const refused = await bystander.api.post('/api/v1/organizations/invitations/decline', {
            data: { token },
        });
        expect(refused.status()).toBe(403);

        const pending = await owner.api.json(
            owner.api.get(`/api/v1/organizations/${orgId}/invitations`),
            200,
        );
        expect(pending.map((row) => row.id)).toContain(invitation.id);
    });

    test('an accepted invitation cannot be declined afterwards', async ({
                                                                            createAccount,
                                                                            mailpit,
                                                                        }) => {
        const { member, inviteToken } = await orgWithMember(
            createAccount,
            mailpit,
            'Naplo E2E Regret',
        );

        const refused = await member.api.post('/api/v1/organizations/invitations/decline', {
            data: { token: inviteToken },
        });
        expect(refused.status()).toBe(409);
    });

    test('an unknown token cannot be declined', async ({ newUser }) => {
        const nobody = await newUser('nobody');

        const refused = await nobody.post('/api/v1/organizations/invitations/decline', {
            data: { token: '00000000-0000-4000-8000-000000000000' },
        });
        expect(refused.status()).toBe(404);
    });
});









