import { test, expect, expectStatus } from '../../support/fixtures.js';
import { createRecording } from '../../support/recordings.js';
import { wavBytes } from '../../support/audio.js';

/**
 * The desktop ONNX worker is not part of this stack, so the suite POSTs the
 * same wire contract it would have sent straight at the backend. Embeddings
 * are one-hot vectors on purpose: two different index scores cosine 0 (never
 * a match) and the same index scores 1.0 (a confident match), which is what
 * drives the matcher down its active-learning path.
 */
const EMBEDDING_DIMS = 192;
const LABEL_A = 'SPEAKER_L_00';
const LABEL_B = 'SPEAKER_L_01';
const UNKNOWN_ID = '0'.repeat(24);

const embedding = (index) => Array.from({ length: EMBEDDING_DIMS }, (_, i) => (i === index ? 1 : 0));

const WAV_BYTES = wavBytes();
const WAV_SAMPLE = WAV_BYTES.toString('base64');

const seg = (start, end, speakerId, text) => ({ start, end, speakerId, text });

const sample = (index, { audio = true } = {}) => ({
    embedding: embedding(index),
    audioSample: audio ? WAV_SAMPLE : null,
    sampleDurationSeconds: audio ? 1 : 0.4,
});

const speakerData = (speakerId, index, samples = [sample(index)]) => ({
    speakerId,
    embedding: embedding(index),
    samples,
});

const submitDiarization = (api, recordingId, body) =>
    api.json(api.post(`/api/v1/recordings/${recordingId}/diarization`, { data: body }), 200);

const createSpeaker = (api, data) => api.json(api.post('/api/v1/speakers', { data }), 200);

const listOrphanPrototypes = (api, recordingId, label) =>
    api.json(api.get(`/api/v1/recordings/${recordingId}/speakers/local/${label}/prototypes`), 200);

const listSpeakerPrototypes = (api, speakerId) =>
    api.json(api.get(`/api/v1/speakers/${speakerId}/prototypes`), 200);

/** A recording whose two Unknown bubbles each carry parked voice samples. */
async function diarizedRecording(api, speakers) {
    const { id } = await createRecording(api);
    await submitDiarization(api, id, {
        segments: [
            seg(0, 4, LABEL_A, 'First voice opening the meeting.'),
            seg(4, 9, LABEL_B, 'Second voice answering back.'),
        ],
        speakers,
    });
    return id;
}

/**
 * Name a bubble (promoting its parked sample), then re-diarize an identical
 * voice in a second recording so the matcher ingests a pending prototype.
 */
async function speakerWithPendingSample(api, name) {
    const first = await diarizedRecording(api, [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)]);
    const speaker = await createSpeaker(api, {
        name,
        fromRecordingId: first,
        fromLocalLabel: LABEL_A,
    });

    const { id: second } = await createRecording(api);
    const rematch = await submitDiarization(api, second, {
        segments: [seg(0, 6, LABEL_A, 'The very same voice in a later recording.')],
        speakers: [speakerData(LABEL_A, 0)],
    });
    return { speaker, rematch, first, second };
}

test.describe('Diarization > Prototypes', () => {
    test('parked samples for an Unknown bubble are listed with their provenance', async ({
                                                                                             newUser,
                                                                                         }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0, [sample(0), sample(0, { audio: false })]),
            speakerData(LABEL_B, 1),
        ]);

        const parked = await listOrphanPrototypes(api, recordingId, LABEL_A);
        expect(parked).toHaveLength(2);
        // Two rows, not one row titled twice.
        expect(new Set(parked.map((p) => p.id)).size).toBe(2);
        for (const item of parked) {
            expect(item).toMatchObject({ source: 'auto', sourceRecordingId: recordingId });
            expect(Number.isNaN(Date.parse(item.createdAt))).toBe(false);
        }
        // Each sample keeps its own duration and the one that carried bytes is
        // playable, so these are two distinct fingerprints rather than placeholders.
        expect(parked.map((p) => p.sampleDurationSeconds).sort((a, b) => a - b)).toEqual([0.4, 1]);
        expect(parked.find((p) => p.hasAudio).sampleDurationSeconds).toBe(1);
        expect(parked.find((p) => !p.hasAudio).sampleDurationSeconds).toBe(0.4);
        expect(await listOrphanPrototypes(api, recordingId, LABEL_B)).toHaveLength(1);
        // A label the diarizer never emitted simply has nothing parked under it.
        expect(await listOrphanPrototypes(api, recordingId, 'SPEAKER_L_09')).toEqual([]);
    });

    test('a parked sample streams as wav and can be deleted individually', async ({ newUser }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0, [sample(0), sample(0)]),
            speakerData(LABEL_B, 1),
        ]);
        const [first, second] = await listOrphanPrototypes(api, recordingId, LABEL_A);

        const audio = await api.get(
            `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_A}/prototypes/${first.id}/audio`,
        );
        expect(audio.status()).toBe(200);
        expect(audio.headers()['content-type']).toContain('audio/wav');
        const body = await audio.body();
        expect(body.byteLength).toBe(WAV_BYTES.byteLength);
        expect(body.subarray(0, 4).toString('ascii')).toBe('RIFF');

        await expectStatus(
            await api.delete(
                `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_A}/prototypes/${first.id}`,
            ),
            204,
        );
        const remaining = await listOrphanPrototypes(api, recordingId, LABEL_A);
        expect(remaining.map((p) => p.id)).toEqual([second.id]);
    });

    test('a parked sample stored without audio has nothing to stream', async ({ newUser }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0, [sample(0, { audio: false })]),
            speakerData(LABEL_B, 1),
        ]);

        const [silent] = await listOrphanPrototypes(api, recordingId, LABEL_A);
        expect(silent.hasAudio).toBe(false);

        const refused = await api.get(
            `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_A}/prototypes/${silent.id}/audio`,
        );
        expect(refused.status()).toBe(404);
    });

    test('a parked sample cannot be reached through the wrong bubble label', async ({ newUser }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0),
            speakerData(LABEL_B, 1),
        ]);
        const [parkedUnderA] = await listOrphanPrototypes(api, recordingId, LABEL_A);

        // Defence in depth: the id has to match the (recording, label) in the path.
        const streamed = await api.get(
            `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_B}/prototypes/${parkedUnderA.id}/audio`,
        );
        const deleted = await api.delete(
            `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_B}/prototypes/${parkedUnderA.id}`,
        );
        expect(streamed.status()).toBe(404);
        expect(deleted.status()).toBe(404);
        expect(await listOrphanPrototypes(api, recordingId, LABEL_A)).toHaveLength(1);
    });

    test('an unknown parked-sample id is a 404', async ({ newUser }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0),
            speakerData(LABEL_B, 1),
        ]);
        const base = `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_A}/prototypes/${UNKNOWN_ID}`;

        expect((await api.get(`${base}/audio`)).status()).toBe(404);
        expect((await api.delete(base)).status()).toBe(404);
    });

    test('a promoted sample becomes a prototype of the named speaker', async ({ newUser }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0),
            speakerData(LABEL_B, 1),
        ]);
        const alice = await createSpeaker(api, {
            name: 'Prototyped Alice',
            fromRecordingId: recordingId,
            fromLocalLabel: LABEL_A,
        });

        const prototypes = await listSpeakerPrototypes(api, alice.id);
        expect(prototypes).toHaveLength(1);
        expect(prototypes[0]).toMatchObject({
            source: 'user_confirmed',
            sourceRecordingId: recordingId,
            hasAudio: true,
            sampleDurationSeconds: 1,
        });

        const audio = await api.get(
            `/api/v1/speakers/${alice.id}/prototypes/${prototypes[0].id}/audio`,
        );
        expect(audio.status()).toBe(200);
        expect(audio.headers()['content-type']).toContain('audio/wav');
        expect((await audio.body()).byteLength).toBe(WAV_BYTES.byteLength);
    });

    test('deleting a prototype keeps the speaker and its other samples', async ({ newUser }) => {
        test.slow();
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0, [sample(0), sample(0)]),
            speakerData(LABEL_B, 1),
        ]);
        const alice = await createSpeaker(api, {
            name: 'Pruned Alice',
            fromRecordingId: recordingId,
            fromLocalLabel: LABEL_A,
        });
        const prototypes = await listSpeakerPrototypes(api, alice.id);
        expect(prototypes).toHaveLength(2);

        await expectStatus(
            await api.delete(`/api/v1/speakers/${alice.id}/prototypes/${prototypes[0].id}`),
            204,
        );

        expect((await listSpeakerPrototypes(api, alice.id)).map((p) => p.id)).toEqual([
            prototypes[1].id,
        ]);
        const speakers = await api.json(api.get('/api/v1/speakers'), 200);
        expect(speakers.find((s) => s.id === alice.id).prototypeCount).toBe(1);
    });

    test('a prototype cannot be reached through the wrong speaker', async ({ newUser }) => {
        test.slow();
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0),
            speakerData(LABEL_B, 1),
        ]);
        const alice = await createSpeaker(api, {
            name: 'Owner Alice',
            fromRecordingId: recordingId,
            fromLocalLabel: LABEL_A,
        });
        const bob = await createSpeaker(api, {
            name: 'Bystander Bob',
            fromRecordingId: recordingId,
            fromLocalLabel: LABEL_B,
        });
        const [aliceProto] = await listSpeakerPrototypes(api, alice.id);

        // Same owner, wrong parent speaker: still has to read as "not found".
        expect(
            (await api.get(`/api/v1/speakers/${bob.id}/prototypes/${aliceProto.id}/audio`)).status(),
        ).toBe(404);
        expect(
            (await api.delete(`/api/v1/speakers/${bob.id}/prototypes/${aliceProto.id}`)).status(),
        ).toBe(404);
        expect(
            (await api.patch(`/api/v1/speakers/${bob.id}/prototypes/${aliceProto.id}/approve`)).status(),
        ).toBe(404);
        expect(await listSpeakerPrototypes(api, alice.id)).toHaveLength(1);
    });

    test('a confident re-match parks a pending sample the user can approve', async ({ newUser }) => {
        test.slow();
        const api = await newUser('protos');
        const { speaker, rematch } = await speakerWithPendingSample(api, 'Rematched Alice');

        expect(rematch.matchedSpeakers).toHaveLength(1);
        expect(rematch.matchedSpeakers[0]).toMatchObject({
            diarizationSpeakerId: LABEL_A,
            speakerId: speaker.id,
            name: 'Rematched Alice',
            newPrototype: true,
        });
        expect(rematch.matchedSpeakers[0].confidence).toBeCloseTo(1, 5);

        const prototypes = await listSpeakerPrototypes(api, speaker.id);
        expect(prototypes.map((p) => p.source).sort()).toEqual(['pending', 'user_confirmed']);

        const pending = prototypes.find((p) => p.source === 'pending');
        await expectStatus(
            await api.patch(`/api/v1/speakers/${speaker.id}/prototypes/${pending.id}/approve`),
            204,
        );

        const approved = await listSpeakerPrototypes(api, speaker.id);
        expect(approved.find((p) => p.id === pending.id).source).toBe('confirmed');
    });

    test('approving an already-settled sample is a no-op', async ({ newUser }) => {
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0),
            speakerData(LABEL_B, 1),
        ]);
        const alice = await createSpeaker(api, {
            name: 'Settled Alice',
            fromRecordingId: recordingId,
            fromLocalLabel: LABEL_A,
        });
        const [promoted] = await listSpeakerPrototypes(api, alice.id);

        await expectStatus(
            await api.patch(`/api/v1/speakers/${alice.id}/prototypes/${promoted.id}/approve`),
            204,
        );

        expect((await listSpeakerPrototypes(api, alice.id))[0].source).toBe('user_confirmed');
    });

    test('approve-all settles every pending sample for a speaker', async ({ newUser }) => {
        test.slow();
        const api = await newUser('protos');
        const { speaker } = await speakerWithPendingSample(api, 'Bulk Alice');
        expect((await listSpeakerPrototypes(api, speaker.id)).some((p) => p.source === 'pending')).toBe(
            true,
        );

        await expectStatus(
            await api.post(`/api/v1/speakers/${speaker.id}/prototypes/approve-all`),
            204,
        );

        const prototypes = await listSpeakerPrototypes(api, speaker.id);
        expect(prototypes.some((p) => p.source === 'pending')).toBe(false);
        expect(prototypes.map((p) => p.source).sort()).toEqual(['confirmed', 'user_confirmed']);

        // Nothing left to settle, so a repeat call still succeeds.
        await expectStatus(
            await api.post(`/api/v1/speakers/${speaker.id}/prototypes/approve-all`),
            204,
        );
    });

    test('an unknown prototype id is a 404 on every per-sample route', async ({ newUser }) => {
        const api = await newUser('protos');
        const alice = await createSpeaker(api, { name: 'Empty Alice' });
        const base = `/api/v1/speakers/${alice.id}/prototypes/${UNKNOWN_ID}`;

        expect((await api.get(`${base}/audio`)).status()).toBe(404);
        expect((await api.delete(base)).status()).toBe(404);
        expect((await api.patch(`${base}/approve`)).status()).toBe(404);
        expect(await listSpeakerPrototypes(api, alice.id)).toEqual([]);
    });

    test('a stranger cannot list, stream, delete or approve another user\'s samples', async ({
                                                                                                 newUser,
                                                                                             }) => {
        test.slow();
        const api = await newUser('protos');
        const recordingId = await diarizedRecording(api, [
            speakerData(LABEL_A, 0),
            speakerData(LABEL_B, 1),
        ]);
        const [parked] = await listOrphanPrototypes(api, recordingId, LABEL_B);
        const alice = await createSpeaker(api, {
            name: 'Confidential Alice',
            fromRecordingId: recordingId,
            fromLocalLabel: LABEL_A,
        });
        const [proto] = await listSpeakerPrototypes(api, alice.id);

        const stranger = await newUser('stranger');
        const orphanBase = `/api/v1/recordings/${recordingId}/speakers/local/${LABEL_B}/prototypes`;
        const speakerBase = `/api/v1/speakers/${alice.id}/prototypes`;

        const refusals = [
            await stranger.get(orphanBase),
            await stranger.get(`${orphanBase}/${parked.id}/audio`),
            await stranger.delete(`${orphanBase}/${parked.id}`),
            await stranger.get(speakerBase),
            await stranger.get(`${speakerBase}/${proto.id}/audio`),
            await stranger.delete(`${speakerBase}/${proto.id}`),
            await stranger.patch(`${speakerBase}/${proto.id}/approve`),
            await stranger.post(`${speakerBase}/approve-all`),
        ];
        for (const refusal of refusals) expect(refusal.status()).toBe(403);

        expect(await listSpeakerPrototypes(api, alice.id)).toHaveLength(1);
        expect(await listOrphanPrototypes(api, recordingId, LABEL_B)).toHaveLength(1);
    });
});


segments


import { test, expect, expectStatus } from '../../support/fixtures.js';
import { TRANSCRIPT, createRecording, appendSlice } from '../../support/recordings.js';
import { wavBytes } from '../../support/audio.js';

/**
 * The desktop ONNX worker is not part of this stack, so the suite POSTs the
 * same wire contract it would have sent straight at the backend. Embeddings
 * are one-hot vectors on purpose: two different index scores cosine 0 (never
 * a match) and the same index scores 1.0 (a confident match), which pins the
 * matcher's behaviour without needing a real voice model.
 */
const EMBEDDING_DIMS = 192;
const LABEL_A = 'SPEAKER_L_00';
const LABEL_B = 'SPEAKER_L_01';
const LABEL_C = 'SPEAKER_L_02';

/** TranscriptMerger.sourceFromLabel keys off exactly these two prefixes. */
const MIC_LABEL = 'SPEAKER_M_00';
const UNPREFIXED_LABEL = 'CLUSTER_7';
const UNKNOWN_ID = '0'.repeat(24);

const embedding = (index) => Array.from({ length: EMBEDDING_DIMS }, (_, i) => (i === index ? 1 : 0));

const WAV_SAMPLE = wavBytes().toString('base64');

const seg = (start, end, speakerId, text) => ({ start, end, speakerId, text });

/** No `text` key at all - what pushes TranscriptMerger off its ASR-driven path. */
const untextedSeg = (start, end, speakerId) => ({ start, end, speakerId });

const speakerData = (speakerId, index) => ({
    speakerId,
    embedding: embedding(index),
    samples: [{ embedding: embedding(index), audioSample: WAV_SAMPLE, sampleDurationSeconds: 1 }],
});

const submitDiarization = (api, recordingId, body) =>
    api.json(api.post(`/api/v1/recordings/${recordingId}/diarization`, { data: body }), 200);

const readRecording = (api, recordingId) => api.json(api.get(`/api/v1/recordings/${recordingId}`), 200);

const createSpeaker = (api, name) => api.json(api.post('/api/v1/speakers', { data: { name } }), 200);

const listOrphanPrototypes = (api, recordingId, label) =>
    api.json(api.get(`/api/v1/recordings/${recordingId}/speakers/local/${label}/prototypes`), 200);

/** Populates recording.transcript and recording.transcriptChunks in one call. */
async function appendChunks(api, recordingId, text, chunks) {
    await api.json(
        api.post(`/api/v1/recordings/${recordingId}/transcript/append`, {
            data: { text, offsetSeconds: 0, chunks },
        }),
        200,
    );
}

/** Two adjacent bubbles, both unattributed - the state every recording starts in. */
const twoBubbles = () => ({
    segments: [
        seg(0, 4, LABEL_A, 'First voice opening the meeting.'),
        seg(4, 9, LABEL_B, 'Second voice answering back.'),
    ],
    speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
});

/**
 * Re-label [0, 5] by hand, arm preserve-manual, apply `options` on top of the
 * armed flag, then re-diarize; returns the surviving segments. Applying every
 * candidate over an already-armed flag is what separates "this value never
 * turned it on" from "a later falsy call turned it back off".
 */
async function rerunAfterOptions(api, recordingId, speakerId, options) {
    await submitDiarization(api, recordingId, {
        segments: [
            seg(0, 5, LABEL_A, 'The half the user labelled by hand.'),
            seg(5, 10, LABEL_B, 'The half the user left alone.'),
        ],
        speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
    });

    await expectStatus(
        await api.patch(`/api/v1/recordings/${recordingId}/segments/assign-speaker`, {
            data: { start: 0, end: 5, speakerId },
        }),
        204,
    );

    const setOptions = (data) =>
        api.patch(`/api/v1/recordings/${recordingId}/diarization/options`, { data });
    await expectStatus(await setOptions({ preserveManual: true }), 204);
    await expectStatus(await setOptions(options), 204);

    await submitDiarization(api, recordingId, {
        segments: [seg(0, 10, LABEL_C, 'A fresh run over the hand-labelled half.')],
        speakers: [speakerData(LABEL_C, 2)],
    });

    return (await readRecording(api, recordingId)).segments;
}

test.describe('Diarization > Segments', () => {
    test('submitted segments land on the recording as unattributed bubbles', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);

        const response = await submitDiarization(api, id, twoBubbles());

        expect(response.recordingId).toBe(id);
        expect(response.totalSegments).toBe(2);
        // Speakers are never auto-created, so a first run leaves every label unmatched.
        expect(response.matchedSpeakers.map((m) => m.diarizationSpeakerId)).toEqual([LABEL_A, LABEL_B]);
        for (const matched of response.matchedSpeakers) {
            expect(matched.speakerId).toBeNull();
            expect(matched.name).toBeNull();
            expect(matched.confidence).toBe(0);
            expect(matched.newPrototype).toBe(false);
        }

        const recording = await readRecording(api, id);
        expect(recording.diarizationStatus).toBe('COMPLETED');
        expect(recording.segments).toHaveLength(2);
        expect(recording.segments[0]).toMatchObject({
            start: 0,
            end: 4,
            kind: 'orphan',
            speakerId: null,
            localLabel: LABEL_A,
            text: 'First voice opening the meeting.',
            source: 'speaker',
            editSource: 'AUTO',
        });
        expect(recording.segments[1]).toMatchObject({
            start: 4,
            end: 9,
            kind: 'orphan',
            speakerId: null,
            localLabel: LABEL_B,
            text: 'Second voice answering back.',
            source: 'speaker',
            editSource: 'AUTO',
        });
    });

    test('a submission with no speaker data still writes bubbles but parks no samples', async ({
                                                                                                   newUser,
                                                                                               }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);

        const response = await submitDiarization(api, id, {
            segments: [seg(0, 4, LABEL_A, 'A bubble with no fingerprint behind it.')],
        });

        expect(response.totalSegments).toBe(1);
        expect(response.matchedSpeakers).toEqual([]);

        const recording = await readRecording(api, id);
        expect(recording.segments[0]).toMatchObject({ kind: 'orphan', localLabel: LABEL_A });
        // Nothing to park, so the Unknown chip has no clip and no listable samples.
        expect(await listOrphanPrototypes(api, id, LABEL_A)).toEqual([]);
        expect(
            (await api.get(`/api/v1/recordings/${id}/speakers/local/${LABEL_A}/audio`)).status(),
        ).toBe(404);
    });

    test('an empty segment list completes with nothing on the timeline', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);

        const response = await submitDiarization(api, id, { segments: [], speakers: [] });

        expect(response.totalSegments).toBe(0);
        expect(response.matchedSpeakers).toEqual([]);
        const recording = await readRecording(api, id);
        expect(recording.segments).toEqual([]);
        expect(recording.diarizationStatus).toBe('COMPLETED');
    });

    test('a second submission replaces the previous segments outright', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, twoBubbles());

        const rerun = await submitDiarization(api, id, {
            segments: [seg(0, 12, LABEL_C, 'One single stretch after re-running the diarizer.')],
            speakers: [speakerData(LABEL_C, 2)],
        });

        expect(rerun.totalSegments).toBe(1);
        const recording = await readRecording(api, id);
        expect(recording.segments).toHaveLength(1);
        expect(recording.segments[0]).toMatchObject({
            start: 0,
            end: 12,
            kind: 'orphan',
            localLabel: LABEL_C,
            text: 'One single stretch after re-running the diarizer.',
            editSource: 'AUTO',
        });

        // The parked samples are replaced too, not accumulated: the first run's
        // Two Unknown chips leave nothing behind for the matcher to promote.
        expect(await listOrphanPrototypes(api, id, LABEL_A)).toEqual([]);
        expect(await listOrphanPrototypes(api, id, LABEL_B)).toEqual([]);
        expect(await listOrphanPrototypes(api, id, LABEL_C)).toHaveLength(1);
    });

    test('near-identical bubbles from a stereo double-run are deduplicated', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        const line = 'Both channels heard exactly the same sentence.';

        // Same text, same (null) attribution, >=90% overlap - the collapse rule.
        const collapsed = await submitDiarization(api, id, {
            segments: [seg(0, 4, LABEL_A, line), seg(0.1, 4, LABEL_B, line)],
            speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
        });
        expect(collapsed.totalSegments).toBe(1);
        expect((await readRecording(api, id)).segments[0]).toMatchObject({
            start: 0,
            end: 4,
            localLabel: LABEL_A,
        });

        // Control: the very same overlap survives once the text differs.
        const kept = await submitDiarization(api, id, {
            segments: [seg(0, 4, LABEL_A, line), seg(0.1, 4, LABEL_B, `${line} Or nearly.`)],
            speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
        });
        expect(kept.totalSegments).toBe(2);
        const keptSegments = (await readRecording(api, id)).segments;
        expect(keptSegments.map((s) => s.localLabel)).toEqual([LABEL_A, LABEL_B]);
        expect(keptSegments.map((s) => s.start)).toEqual([0, 0.1]);
    });

    test('untexted segments take their words from the recording transcript chunks', async ({
                                                                                               newUser,
                                                                                           }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await appendChunks(api, id, 'Chunked transcript for the overlap merger.', [
            { start: 0, end: 4, text: 'The first speaker opens the meeting.' },
            { start: 4, end: 9, text: 'The second speaker answers the question.' },
            { start: 20, end: 24, text: 'A late aside no diarization run covered.' },
        ]);

        expect((await readRecording(api, id)).transcriptChunks).toHaveLength(3);

        const response = await submitDiarization(api, id, {
            segments: [untextedSeg(0, 4, LABEL_A), untextedSeg(4, 9, LABEL_B)],
            speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
        });

        // One output segment per chunk, not one per diarization turn.
        expect(response.totalSegments).toBe(2);
        const recording = await readRecording(api, id);
        expect(recording.segments[0]).toMatchObject({
            start: 0,
            end: 4,
            text: 'The first speaker opens the meeting.',
            localLabel: LABEL_A,
            source: 'speaker',
        });
        expect(recording.segments[1]).toMatchObject({
            start: 4,
            end: 9,
            text: 'The second speaker answers the question.',
            localLabel: LABEL_B,
            source: 'speaker',
        });
        // Zero overlap against a 4s chunk needs >=1s to count as confident, so this
        // chunk is attributed to nobody at all - not even to a cluster label.
        expect(recording.segments[2]).toMatchObject({
            start: 20,
            end: 24,
            text: 'A late aside no diarization run covered.',
            kind: 'orphan',
            speakerId: null,
            source: null,
        });
    });

    test('untexted segments with only a flat transcript split it by duration', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await expectStatus(await appendSlice(api, id, `${TRANSCRIPT}`), 200);
        expect((await readRecording(api, id)).text).toBe(TRANSCRIPT);
        expect((await readRecording(api, id)).transcriptChunks).toEqual([]);

        const response = await submitDiarization(api, id, {
            segments: [untextedSeg(0, 4, LABEL_A), untextedSeg(4, 12, LABEL_B)],
            speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
        });

        expect(response.totalSegments).toBe(2);
        const texts = (await readRecording(api, id)).segments.map((s) => s.text);
        // Cut at word boundaries only: the whole transcript is redistributed.
        expect(texts.join(' ')).toBe(TRANSCRIPT);
        // round((4/12) * wordCount) words on the 4s turn, the remainder on the 8s one.
        const words = TRANSCRIPT.split(' ').length;
        expect(texts[0].split(' ')).toHaveLength(Math.round(words / 3));
        expect(texts[1].split(' ')).toHaveLength(words - Math.round(words / 3));
    });

    test('untexted segments with no transcript at all keep timing and label only', async ({
                                                                                              newUser,
                                                                                          }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);

        const response = await submitDiarization(api, id, {
            segments: [
                untextedSeg(0, 4, LABEL_A),
                untextedSeg(4, 9, MIC_LABEL),
                untextedSeg(9, 12, UNPREFIXED_LABEL),
            ],
            speakers: [
                speakerData(LABEL_A, 0),
                speakerData(MIC_LABEL, 1),
                speakerData(UNPREFIXED_LABEL, 2),
            ],
        });

        expect(response.totalSegments).toBe(3);
        const { segments } = await readRecording(api, id);
        expect(segments.map((s) => s.text)).toEqual([null, null, null]);
        expect(segments.map((s) => s.localLabel)).toEqual([LABEL_A, MIC_LABEL, UNPREFIXED_LABEL]);
        // SPEAKER_L_ -> loopback, SPEAKER_M_ -> microphone, anything else -> unknown.
        expect(segments.map((s) => s.source)).toEqual(['speaker', 'mic', null]);
    });

    test('the desktop can push the diarization status through every state', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);

        for (const status of ['PENDING', 'IN_PROGRESS', 'FAILED', 'COMPLETED', 'NONE']) {
            const body = await api.json(
                api.patch(`/api/v1/recordings/${id}/diarization/status`, { data: { status } }),
                200,
            );
            expect(body).toEqual({ status });
            expect((await readRecording(api, id)).diarizationStatus).toBe(status);
        }
    });

    test('an unknown or missing diarization status is rejected', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);

        // valueOf is case-sensitive, so the SPA's own lowercase spelling is refused.
        for (const data of [
            { status: 'BANANA' },
            { status: 'pending' },
            { status: '' },
            { status: null },
            {},
        ]) {
            const refused = await api.patch(`/api/v1/recordings/${id}/diarization/status`, { data });
            expect(refused.status()).toBe(400);
        }

        // A rejected value must not have moved the recording off its default.
        expect((await readRecording(api, id)).diarizationStatus).toBe('NONE');
    });

    test('preserve-manual only honours a real JSON boolean', async ({ newUser }) => {
        test.slow();
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        const alice = await createSpeaker(api, 'Coerced Alice');

        // `body.get("preserveManual") instanceof Boolean && b` - a truthy string
        // or number has no charm to disarm the flag, not arm it.
        for (const options of [
            { preserveManual: 'yes' },
            { preserveManual: 1 },
            { preserveManual: false },
            {},
        ]) {
            const flattened = await rerunAfterOptions(api, id, alice.id, options);
            expect(flattened, JSON.stringify(options)).toHaveLength(1);
            expect(flattened[0], JSON.stringify(options)).toMatchObject({
                start: 0,
                end: 10,
                kind: 'orphan',
                speakerId: null,
                localLabel: LABEL_C,
                editSource: 'AUTO',
            });
        }

        // Control through the identical sequence: a literal `true` does survive,
        // so the four refusals above are about the value and not about the flow.
        const preserved = await rerunAfterOptions(api, id, alice.id, { preserveManual: true });
        expect(preserved).toHaveLength(2);
        expect(preserved[0]).toMatchObject({
            start: 0,
            end: 5,
            kind: 'named',
            speakerId: alice.id,
            editSource: 'USER_ASSIGN',
        });
        expect(preserved[1]).toMatchObject({ start: 5, end: 10, localLabel: LABEL_C });
    });

    test('re-diarization keeps manually assigned segments when preserveManual is set', async ({
                                                                                                  newUser,
                                                                                              }) => {
        test.slow();
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, {
            segments: [
                seg(0, 5, LABEL_A, 'The half the user labelled by hand.'),
                seg(5, 10, LABEL_B, 'The half the user left alone.'),
            ],
            speakers: [speakerData(LABEL_A, 0), speakerData(LABEL_B, 1)],
        });

        const alice = await createSpeaker(api, 'Preserved Alice');
        await expectStatus(
            await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                data: { start: 0, end: 5, speakerId: alice.id },
            }),
            204,
        );

        await expectStatus(
            await api.patch(`/api/v1/recordings/${id}/diarization/options`, {
                data: { preserveManual: true },
            }),
            204,
        );

        const rerun = await submitDiarization(api, id, {
            segments: [seg(0, 10, LABEL_C, 'A fresh run that would otherwise flatten everything.')],
            speakers: [speakerData(LABEL_C, 2)],
        });

        expect(rerun.totalSegments).toBe(2);

        const recording = await readRecording(api, id);
        expect(recording.segments).toHaveLength(2);
        expect(recording.segments[0]).toMatchObject({
            start: 0,
            end: 5,
            kind: 'named',
            speakerId: alice.id,
            editSource: 'USER_ASSIGN',
        });
        // The fresh auto segment is clipped so it starts where the protected one ends.
        expect(recording.segments[1]).toMatchObject({
            start: 5,
            end: 10,
            kind: 'orphan',
            localLabel: LABEL_C,
            editSource: 'AUTO',
        });

        // The flag is one-shot: the next run no longer protects anything.
        const third = await submitDiarization(api, id, {
            segments: [seg(0, 10, LABEL_C, 'A third run with the flag already spent.')],
            speakers: [speakerData(LABEL_C, 2)],
        });

        expect(third.totalSegments).toBe(1);
        expect((await readRecording(api, id)).segments[0]).toMatchObject({
            kind: 'orphan',
            localLabel: LABEL_C,
        });
    });

    test('assign-speaker names every segment inside the range and trains the matcher', async ({
                                                                                                  newUser,
                                                                                              }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, twoBubbles());
        const alice = await createSpeaker(api, 'Assigned Alice');

        await expectStatus(
            await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                data: { start: 0, end: 4, speakerId: alice.id },
            }),
            204,
        );

        const recording = await readRecording(api, id);
        expect(recording.segments[0]).toMatchObject({
            start: 0,
            end: 4,
            kind: 'named',
            speakerId: alice.id,
            localLabel: null,
            editSource: 'USER_ASSIGN',
        });

        // The other bubble was outside the range and stays untouched.
        expect(recording.segments[1]).toMatchObject({ kind: 'orphan', localLabel: LABEL_B });

        // Active learning: naming the bubble promotes its parked voice sample and
        // empties the Unknown chip's sample list.
        const speakers = await api.json(api.get('/api/v1/speakers'), 200);
        expect(speakers.find((s) => s.id === alice.id).prototypeCount).toBe(1);
        expect(await listOrphanPrototypes(api, id, LABEL_A)).toEqual([]);
    });

    test('assign-speaker only takes segments fully inside the range', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, twoBubbles());
        const alice = await createSpeaker(api, 'Partial Alice');

        // [0, 6] fully contains the 0-4 bubble but only clips into the 4-9 one.
        await expectStatus(
            await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                data: { start: 0, end: 6, speakerId: alice.id },
            }),
            204,
        );

        const { segments } = await readRecording(api, id);
        expect(segments.map((s) => s.kind)).toEqual(['named', 'orphan']);
        expect(segments[1].localLabel).toBe(LABEL_B);
    });

    test('assign-speaker rejects a body without start, end or speaker id', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, twoBubbles());
        const alice = await createSpeaker(api, 'Rejected Alice');

        for (const data of [
            { end: 4, speakerId: alice.id },
            { start: 0, speakerId: alice.id },
            { start: 0, end: 4 },
            { start: 0, end: 4, speakerId: '' },
            { start: 0, end: 4, speakerId: 42 },
        ]) {
            const refused = await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, { data });
            expect(refused.status()).toBe(400);
        }

        // A 400 has to be a refusal, not a partial write.
        const { segments } = await readRecording(api, id);
        expect(segments.map((s) => s.kind)).toEqual(['orphan', 'orphan']);
        expect(segments.map((s) => s.localLabel)).toEqual([LABEL_A, LABEL_B]);
    });

    test('assign-speaker is a 404 with no matching segment, none at all, or no such speaker', async ({
                                                                                                         newUser,
                                                                                                     }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        const alice = await createSpeaker(api, 'Missing-Range Alice');

        // Never diarized: the recording carries no segments at all.
        expect(
            (
                await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                    data: { start: 0, end: 4, speakerId: alice.id },
                })
            ).status(),
        ).toBe(404);

        await submitDiarization(api, id, twoBubbles());

        expect(
            (
                await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                    data: { start: 900, end: 999, speakerId: alice.id },
                })
            ).status(),
        ).toBe(404);

        // The speaker is resolved before the range is searched.
        expect(
            (
                await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                    data: { start: 0, end: 4, speakerId: UNKNOWN_ID },
                })
            ).status(),
        ).toBe(404);

        expect((await readRecording(api, id)).segments.map((s) => s.kind)).toEqual([
            'orphan',
            'orphan',
        ]);
    });

    test('assign-speaker refuses a speaker owned by somebody else', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, twoBubbles());

        const stranger = await newUser('stranger');
        const theirs = await createSpeaker(stranger, 'Not yours');

        const refused = await api.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
            data: { start: 0, end: 4, speakerId: theirs.id },
        });

        expect(refused.status()).toBe(403);
    });

    test('split cuts a bubble into contiguous pieces and reassigns one of them', async ({
                                                                                            newUser,
                                                                                        }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        const line = 'One long uninterrupted stretch of two people talking over each other.';
        await submitDiarization(api, id, {
            segments: [seg(0, 10, LABEL_A, line)],
            speakers: [speakerData(LABEL_A, 0)],
        });

        const bob = await createSpeaker(api, 'Split Bob');

        await expectStatus(
            await api.post(`/api/v1/recordings/${id}/segments/split`, {
                data: {
                    originalStart: 0,
                    originalEnd: 10,
                    splits: [
                        { start: 0, end: 4 },
                        { start: 4, end: 10, speakerId: bob.id },
                    ],
                },
            }),
            204,
        );

        const recording = await readRecording(api, id);
        expect(recording.segments).toHaveLength(2);
        expect(recording.segments[0]).toMatchObject({
            start: 0,
            end: 4,
            kind: 'orphan',
            localLabel: LABEL_A,
            source: 'speaker',
            editSource: 'USER_SPLIT',
        });
        expect(recording.segments[1]).toMatchObject({
            start: 4,
            end: 10,
            kind: 'named',
            speakerId: bob.id,
            localLabel: null,
            source: 'speaker',
            editSource: 'USER_SPLIT',
        });

        // No word-level transcriptChunks exist here, so the backend cannot slice the
        // text and leaves all of it on the first piece.
        expect(recording.segments[0].text).toBe(line);
        expect(recording.segments[1].text).toBe('');
    });

    test('split snaps to word boundaries and slices the text when word timings exist', async ({
                                                                                                  newUser,
                                                                                              }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await appendChunks(api, id, 'alpha bravo charlie delta echo foxtrot ', [
            {
                start: 0,
                end: 10,
                text: 'alpha bravo charlie delta echo foxtrot',
                words: [
                    { start: 0, end: 1, text: 'alpha' },
                    { start: 2, end: 3, text: 'bravo' },
                    { start: 4, end: 5, text: 'charlie' },
                    { start: 6, end: 7, text: 'delta' },
                    { start: 8, end: 9, text: 'echo' },
                    { start: 9, end: 10, text: 'foxtrot' },
                ],
            },
        ]);

        await submitDiarization(api, id, {
            segments: [untextedSeg(0, 10, LABEL_A)],
            speakers: [speakerData(LABEL_A, 0)],
        });

        const bob = await createSpeaker(api, 'Snapped Bob');

        // 5.02 is inside the 0.1s snap tolerance of "charlie"'s end at 5.0.
        await expectStatus(
            await api.post(`/api/v1/recordings/${id}/segments/split`, {
                data: {
                    originalStart: 0,
                    originalEnd: 10,
                    splits: [
                        { start: 0, end: 5.02 },
                        { start: 5.02, end: 10, speakerId: bob.id },
                    ],
                },
            }),
            204,
        );

        const { segments } = await readRecording(api, id);
        expect(segments).toHaveLength(2);
        expect(segments[0]).toMatchObject({
            start: 0,
            end: 5,
            kind: 'orphan',
            localLabel: LABEL_A,
            text: 'alpha bravo charlie',
            editSource: 'USER_SPLIT',
        });
        expect(segments[1]).toMatchObject({
            start: 5,
            end: 10,
            kind: 'named',
            speakerId: bob.id,
            text: 'delta echo foxtrot',
            editSource: 'USER_SPLIT',
        });
    });

    test('split rejects pieces that do not cover the original range', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, {
            segments: [seg(0, 10, LABEL_A, 'A bubble that will not be cut cleanly.')],
            speakers: [speakerData(LABEL_A, 0)],
        });

        for (const splits of [
            [{ start: 0, end: 3 }],
            [
                { start: 0, end: 4 },
                { start: 6, end: 10 },
            ],
            [
                { start: 0, end: 6 },
                { start: 4, end: 10 },
            ],
            [{ start: 4, end: 4 }],
        ]) {
            const refused = await api.post(`/api/v1/recordings/${id}/segments/split`, {
                data: { originalStart: 0, originalEnd: 10, splits },
            });
            expect(refused.status()).toBe(400);
        }

        // Nothing was written: the original bubble is still whole.
        expect((await readRecording(api, id)).segments).toHaveLength(1);
    });

    test('split rejects a malformed body', async ({ newUser }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, {
            segments: [seg(0, 10, LABEL_A, 'A bubble nobody will manage to cut.')],
            speakers: [speakerData(LABEL_A, 0)],
        });

        for (const data of [
            { originalEnd: 10, splits: [{ start: 0, end: 10 }] },
            { originalStart: 0, splits: [{ start: 0, end: 10 }] },
            { originalStart: 0, originalEnd: 10, splits: [] },
            { originalStart: 0, originalEnd: 10, splits: [{ start: 0 }] },
            { originalStart: 0, originalEnd: 10, splits: ['nonsense'] },
            { originalStart: 0, originalEnd: 10, splits: 'nonsense' },
        ]) {
            const refused = await api.post(`/api/v1/recordings/${id}/segments/split`, { data });
            expect(refused.status()).toBe(400);
        }

        const { segments } = await readRecording(api, id);
        expect(segments).toHaveLength(1);
        expect(segments[0]).toMatchObject({ start: 0, end: 10, editSource: 'AUTO' });
    });

    test('split is a 404 with no matching segment and a 403 with a foreign speaker', async ({
                                                                                                newUser,
                                                                                            }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        const stranger = await newUser('stranger');
        const theirs = await createSpeaker(stranger, 'Foreign split speaker');

        // Never diarized: there are no segments to search at all.
        expect(
            (
                await api.post(`/api/v1/recordings/${id}/segments/split`, {
                    data: { originalStart: 0, originalEnd: 10, splits: [{ start: 0, end: 10 }] },
                })
            ).status(),
        ).toBe(404);

        await submitDiarization(api, id, {
            segments: [seg(0, 10, LABEL_A, 'The only bubble in this recording.')],
            speakers: [speakerData(LABEL_A, 0)],
        });

        expect(
            (
                await api.post(`/api/v1/recordings/${id}/segments/split`, {
                    data: { originalStart: 20, originalEnd: 30, splits: [{ start: 20, end: 30 }] },
                })
            ).status(),
        ).toBe(404);

        // Coverage is validated before any per-piece speaker is resolved, so this
        // has to be a well-formed split to reach the ownership check at all.
        expect(
            (
                await api.post(`/api/v1/recordings/${id}/segments/split`, {
                    data: {
                        originalStart: 0,
                        originalEnd: 10,
                        splits: [
                            { start: 0, end: 4 },
                            { start: 4, end: 10, speakerId: theirs.id },
                        ],
                    },
                })
            ).status(),
        ).toBe(403);

        expect((await readRecording(api, id)).segments).toHaveLength(1);
    });

    test('an unknown recording id is a 404 on every segment route', async ({ newUser }) => {
        const api = await newUser('diar');
        const alice = await createSpeaker(api, 'Nowhere Alice');

        // These paths carry no id-shape guard, so a bogus id and a well-formed one
        // that matches nothing both fall through to the repository lookup and
        // surface as "not found" rather than "bad request".
        for (const missing of ['not-a-real-id', UNKNOWN_ID]) {
            const responses = [
                await api.post(`/api/v1/recordings/${missing}/diarization`, {
                    data: { segments: [seg(0, 4, LABEL_A, 'Nowhere to put this.')] },
                }),
                await api.patch(`/api/v1/recordings/${missing}/diarization/status`, {
                    data: { status: 'FAILED' },
                }),
                await api.patch(`/api/v1/recordings/${missing}/diarization/options`, {
                    data: { preserveManual: true },
                }),
                await api.patch(`/api/v1/recordings/${missing}/segments/assign-speaker`, {
                    data: { start: 0, end: 4, speakerId: alice.id },
                }),
                await api.post(`/api/v1/recordings/${missing}/segments/split`, {
                    data: { originalStart: 0, originalEnd: 4, splits: [{ start: 0, end: 4 }] },
                }),
            ];

            for (const response of responses) expect(response.status()).toBe(404);
        }
    });

    test('a stranger can neither submit nor edit another user\'s diarization', async ({
                                                                                          newUser,
                                                                                      }) => {
        const api = await newUser('diar');
        const { id } = await createRecording(api);
        await submitDiarization(api, id, twoBubbles());

        const stranger = await newUser('stranger');
        const theirs = await createSpeaker(stranger, 'Stranger speaker');

        const refusals = [
            await stranger.post(`/api/v1/recordings/${id}/diarization`, {
                data: { segments: [seg(0, 4, LABEL_C, 'Injected by a stranger.')] },
            }),
            await stranger.patch(`/api/v1/recordings/${id}/diarization/status`, {
                data: { status: 'FAILED' },
            }),
            await stranger.patch(`/api/v1/recordings/${id}/diarization/options`, {
                data: { preserveManual: true },
            }),
            await stranger.patch(`/api/v1/recordings/${id}/segments/assign-speaker`, {
                data: { start: 0, end: 4, speakerId: theirs.id },
            }),
            await stranger.post(`/api/v1/recordings/${id}/segments/split`, {
                data: { originalStart: 0, originalEnd: 4, splits: [{ start: 0, end: 4 }] },
            }),
        ];

        for (const refusal of refusals) expect(refusal.status()).toBe(403);

        const recording = await readRecording(api, id);
        expect(recording.diarizationStatus).toBe('COMPLETED');
        expect(recording.segments).toHaveLength(2);
        expect(recording.segments.map((s) => s.localLabel)).toEqual([LABEL_A, LABEL_B]);
    });
});


presence:
import { test, expect, expectStatus } from '../../support/fixtures.js';

// Mirrors the package-private constants in LocalPresenceService.
const NONCE_TTL_SECONDS = 180;
const PRESENCE_TTL_SECONDS = 120;
// jwt.desktop-expiration-minutes (60) - what a re-minted token must carry.
const DESKTOP_LIFETIME_SECONDS = 60 * 60;

/** Read a JWT's claims without verifying it - the signature is the server's business. */
function claims(token) {
    return JSON.parse(Buffer.from(token.split('.')[1], 'base64url').toString('utf8'));
}

/** The SPA half of the handshake: the nonce it hands over via `naplo://launch?nonce=`. */
async function mintNonce(spa) {
    const { nonce } = await spa.json(spa.post('/api/v1/local-presence/expect'), 200);
    return nonce;
}

/**
 * The desktop half. Sent on the raw context with no CSRF header, because a
 * plain `requests.post` from the local server has no cookie to offer.
 */
function announce(desktop, data) {
    return desktop.ctx.post('/api/v1/local-presence/announce', { data });
}

/** An anonymous context primed to carry a bearer token past the CSRF filter. */
async function bearerClient(newApi) {
    const client = await newApi();
    await client.primeCsrf();
    return client;
}

test.describe('Desktop > Presence', () => {
    test('expect mints a fresh nonce with a published lifetime', async ({ newUser }) => {
        const spa = await newUser('presence-expect');

        const first = await spa.json(spa.post('/api/v1/local-presence/expect'), 200);
        // 24 SecureRandom bytes, url-encoded without padding, so exactly 32 chars.
        // A shortened nonce would be a brute-forceable bootstrap credential.
        expect(first.nonce).toMatch(/^[A-Za-z0-9_-]{32}$/);
        // The advertised TTL. Enforcement lives in announceWithNonce and needs
        // 180 s of wall clock, so this test only pins the published number.
        expect(first.expiresInSeconds).toBe(NONCE_TTL_SECONDS);

        const second = await spa.json(spa.post('/api/v1/local-presence/expect'), 200);
        expect(second.nonce, 'a re-issued nonce must not repeat the last one').not.toBe(first.nonce);
    });

    test('a user with no desktop running reads back an empty presence', async ({ newUser }) => {
        const spa = await newUser('presence-empty');

        // Deliberately 200 + {} rather than 404: the SPA polls this every 15 s
        // while the desktop is closed.
        expect(await spa.json(spa.get('/api/v1/local-presence'), 200)).toEqual({});
    });

    test('the nonce handshake publishes an address the SPA can find', async ({
                                                                                 newUser,
                                                                                 newApi,
                                                                             }) => {
        const spa = await newUser('presence-handshake');
        const desktop = await newApi();
        const nonce = await mintNonce(spa);

        const announced = await announce(desktop, {
            nonce,
            port: 8066,
            scheme: 'http',
            version: '1.2.3',
        });
        await expectStatus(announced, 200);
        expect(await announced.json()).toEqual({ status: 'ok' });

        const presence = await spa.json(spa.get('/api/v1/local-presence'), 200);
        // The controller builds this map by hand; an extra key is something the
        // SPA never asked for and a missing one breaks discovery.
        expect(Object.keys(presence).sort()).toEqual([
            'ageSeconds',
            'lastSeen',
            'port',
            'scheme',
            'version',
        ]);

        expect(presence.port).toBe(8066);
        expect(presence.scheme).toBe('http');
        expect(presence.version).toBe('1.2.3');
        expect(Number.isNaN(Date.parse(presence.lastSeen))).toBe(false);
        expect(presence.ageSeconds).toBeGreaterThanOrEqual(0);
        expect(presence.ageSeconds).toBeLessThan(PRESENCE_TTL_SECONDS);
    });

    test('a nonce is burned by the announce that claims it', async ({ newUser, newApi }) => {
        const spa = await newUser('presence-replay');
        const desktop = await newApi();
        const nonce = await mintNonce(spa);

        await expectStatus(await announce(desktop, { nonce, port: 8067, scheme: 'http' }), 200);

        const replay = await announce(desktop, { nonce, port: 9999, scheme: 'http' });
        await expectStatus(replay, 404);
        expect(await replay.json()).toEqual({ status: 'unknown-nonce' });

        // A replay that half-succeeded would still have moved the SPA's idea of
        // where its desktop lives.
        expect((await spa.json(spa.get('/api/v1/local-presence'), 200)).port).toBe(8067);
    });

    test('a nonce nobody minted cannot register a desktop', async ({ newUser, newApi }) => {
        const spa = await newUser('presence-guess');
        const desktop = await newApi();

        // A real pending nonce exists for this user - the caller just isn't holding it.
        const pendingNonce = await mintNonce(spa);

        for (const nonce of ['not-a-real-nonce', 'x'.repeat(128), '0', pendingNonce.slice(0, -1)]) {
            const refused = await announce(desktop, { nonce, port: 8068, scheme: 'http' });
            await expectStatus(refused, 404);
            expect(await refused.json()).toEqual({ status: 'unknown-nonce' });
        }

        expect(await spa.json(spa.get('/api/v1/local-presence'), 200)).toEqual({});

        // announceWithNonce removes by the key it was handed, so a near-miss guess
        // must not have cancelled the claim the victim is still waiting on.
        await expectStatus(await announce(desktop, { nonce: pendingNonce, port: 8068, scheme: 'http' }), 200);
        expect((await spa.json(spa.get('/api/v1/local-presence'), 200)).port).toBe(8068);
    });

    test('a claimed nonce only registers the user who minted it', async ({ newUser, newApi }) => {
        const victim = await newUser('presence-victim');
        const attacker = await newUser('presence-attacker');
        const desktop = await newApi();

        const victimNonce = await mintNonce(victim);

        // The claim carries the minting user, so the only presence an attacker can
        // ever publish is their own.
        await expectStatus(
            await announce(desktop, { nonce: await mintNonce(attacker), port: 8070, scheme: 'http' }),
            200,
        );

        expect((await attacker.json(attacker.get('/api/v1/local-presence'), 200)).port).toBe(8070);
        expect(await victim.json(victim.get('/api/v1/local-presence'), 200)).toEqual({});

        // ...and spending it left the victim's outstanding claim alone.
        await expectStatus(
            await announce(desktop, { nonce: victimNonce, port: 8071, scheme: 'http' }),
            200,
        );

        expect((await victim.json(victim.get('/api/v1/local-presence'), 200)).port).toBe(8071);
    });

    test('announce validates the address before it spends the nonce', async ({
                                                                                 newUser,
                                                                                 newApi,
                                                                             }) => {
        const spa = await newUser('presence-validation');
        const desktop = await newApi();
        const nonce = await mintNonce(spa);

        for (const data of [
            { nonce: '', port: 8066, scheme: 'http' },
            { nonce, port: 80, scheme: 'http' },
            { nonce, port: 70000, scheme: 'http' },
            { nonce, port: 8066, scheme: 'ftp' },
            { nonce, port: 8066, scheme: '' },
            { nonce, port: 8066, scheme: 'http', version: 'v'.repeat(65) },
            { nonce: 'n'.repeat(129), port: 8066, scheme: 'http' },
        ]) {
            // @Valid on the body raises MethodArgumentNotValidException, which
            // ResponseEntityExceptionHandler pins to 400 deterministically.
            expect((await announce(desktop, data)).status(), JSON.stringify(data)).toBe(400);
        }

        // Nothing was written for any rejected body...
        expect(await spa.json(spa.get('/api/v1/local-presence'), 200)).toEqual({});

        // ...and bean validation runs before the service, so the rows that carried
        // the real nonce must leave it claimable rather than burning the one shot.
        await expectStatus(await announce(desktop, { nonce, port: 8066, scheme: 'http' }), 200);
        expect((await spa.json(spa.get('/api/v1/local-presence'), 200)).port).toBe(8066);
    });

    test('presence is closed to anonymous callers', async ({ newApi }) => {
        const anon = await newApi();
        // Primed so a missing CSRF token cannot be what refuses these calls.
        await anon.primeCsrf();

        const refused = [
            await anon.post('/api/v1/local-presence/expect'),
            await anon.get('/api/v1/local-presence'),
            await anon.post('/api/v1/local-presence/heartbeat', { data: { port: 8066, scheme: 'http' } }),
            await anon.delete('/api/v1/local-presence'),
        ];

        // The filter chain answers before @PreAuthorize gets a say, so the suite
        // accepts either refusal code here.
        for (const response of refused) {
            expect([401, 403], `${response.url()} was reachable anonymously`).toContain(
                response.status(),
            );
        }
    });

    test('an authenticated heartbeat publishes and then moves the address', async ({ newUser }) => {
        const spa = await newUser('presence-heartbeat');

        const first = await spa.json(
            spa.post('/api/v1/local-presence/heartbeat', {
                data: { port: 8072, scheme: 'http', version: '9.9.9' },
            }),
            200,
        );

        expect(first).toEqual({ status: 'ok' });

        expect((await spa.json(spa.get('/api/v1/local-presence'), 200)).port).toBe(8072);

        await expectStatus(
            await spa.post('/api/v1/local-presence/heartbeat', { data: { port: 8073, scheme: 'http' } }),
            200,
        );

        const moved = await spa.json(spa.get('/api/v1/local-presence'), 200);
        expect(moved.port).toBe(8073);
        // An absent version is normalised to "" so the SPA never renders "null".
        expect(moved.version).toBe('');
    });

    test('the heartbeat validates the address it is given', async ({ newUser }) => {
        const spa = await newUser('presence-hb-validation');

        for (const data of [
            { port: 80, scheme: 'http' },
            { port: 70000, scheme: 'http' },
            { port: 8075, scheme: 'ftp' },
            { port: 8075, scheme: '' },
            { port: 8075, scheme: 'http', version: 'v'.repeat(65) },
        ]) {
            expect(
                (await spa.post('/api/v1/local-presence/heartbeat', { data })).status(),
                JSON.stringify(data),
            ).toBe(400);
        }

        expect(await spa.json(spa.get('/api/v1/local-presence'), 200)).toEqual({});
    });

    test('a heartbeat on a fresh desktop token gets no refreshed token', async ({
                                                                                    newUser,
                                                                                    newApi,
                                                                                }) => {
        const spa = await newUser('presence-hb-fresh');
        const { token } = await spa.json(spa.post('/api/v1/auth/local-token'), 200);

        const desktop = await bearerClient(newApi);
        const body = await desktop.json(
            desktop.post('/api/v1/local-presence/heartbeat', {
                data: { port: 8069, scheme: 'http', version: 'e2e-desktop' },
                headers: { Authorization: `Bearer ${token}` },
            }),
            200,
        );

        // Exact equality so a stray refreshedToken cannot slip past. Sliding
        // refresh only opens under jwt.refresh-when-remaining-minutes (30) and
        // this token still has the full 60; the time-based branch needs 30 min of
        // wall clock, so the org-mismatch test below covers the minting path.
        expect(body).toEqual({ status: 'ok' });

        // The bearer heartbeat lands presence for the cookie session's user.
        expect((await spa.json(spa.get('/api/v1/local-presence'), 200)).port).toBe(8069);
    });

    test('a heartbeat whose org claim went stale gets a re-minted token', async ({
                                                                                     createAccount,
                                                                                     newApi,
                                                                                 }) => {
        const { email, api: spa } = await createAccount('presence-hb-org');
        const personalOrgId = (await spa.activeOrg()).id;

        // Creating a business org also switches the active org, so the token
        // minted next carries it.
        const business = await spa.json(
            spa.post('/api/v1/organizations', { data: { name: 'Naplo E2E Presence Org' } }),
            201,
        );
        expect(business.id).not.toBe(personalOrgId);

        const { token } = await spa.json(spa.post('/api/v1/auth/local-token'), 200);
        // Without this the token would not actually be stale and the assertions
        // below would pass for the wrong reason.
        expect(claims(token).org_id).toBe(business.id);

        // The switch the desktop never heard about - another device, or a push
        // that failed while the laptop was asleep.
        await spa.activate(personalOrgId);

        const desktop = await bearerClient(newApi);
        const body = await desktop.json(
            desktop.post('/api/v1/local-presence/heartbeat', {
                data: { port: 8071, scheme: 'http', version: 'e2e-desktop' },
                headers: { Authorization: `Bearer ${token}` },
            }),
            200,
        );

        expect(body.status).toBe('ok');
        const refreshed = claims(body.refreshedToken);
        expect(refreshed.sub).toBe(email);
        // User.defaultOrgId is the source of truth the stale claim is corrected to.
        expect(refreshed.org_id).toBe(personalOrgId);
        // generateDesktopTokenForOrg, not the 24 h cookie variant - handing an
        // always-on background process a long-lived token is the regression here.
        expect(refreshed.exp - refreshed.iat).toBe(DESKTOP_LIFETIME_SECONDS);

        // And it is a working credential, not just a well-shaped string.
        const renewed = await bearerClient(newApi);
        const me = await renewed.json(
            renewed.get('/api/v1/user', { headers: { Authorization: `Bearer ${body.refreshedToken}` } }),
            200,
        );
        expect(me.email).toBe(email);
    });

    test('clearing presence removes it and tolerates a second attempt', async ({ newUser }) => {
        const spa = await newUser('presence-clear');

        await expectStatus(
            await spa.post('/api/v1/local-presence/heartbeat', { data: { port: 8074, scheme: 'http' } }),
            200,
        );
        expect((await spa.json(spa.get('/api/v1/local-presence'), 200)).port).toBe(8074);

        expect(await spa.json(spa.delete('/api/v1/local-presence'), 200)).toEqual({ status: 'ok' });
        expect(await spa.json(spa.get('/api/v1/local-presence'), 200)).toEqual({});

        // Shutdown is fire-and-forget on the desktop side, so a repeat clear must
        // not become an error the tray code has to handle.
        expect(await spa.json(spa.delete('/api/v1/local-presence'), 200)).toEqual({ status: 'ok' });
    });

    test('csrf guards the authenticated presence writes', async ({ newUser }) => {
        const spa = await newUser('presence-csrf');

        // Raw context = no X-XSRF-TOKEN, which is all a cross-site form could send.
        expect((await spa.ctx.post('/api/v1/local-presence/expect')).status()).toBe(403);
        expect(
            (
                await spa.ctx.post('/api/v1/local-presence/heartbeat', {
                    data: { port: 8076, scheme: 'http' },
                })
            ).status(),
        ).toBe(403);
        expect((await spa.ctx.delete('/api/v1/local-presence')).status()).toBe(403);

        await expectStatus(await spa.post('/api/v1/local-presence/expect'), 200);
    });
});



