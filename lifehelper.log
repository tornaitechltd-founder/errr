import { test, expect, expectStatus } from '../../support/fixtures.js';
import { createRecording, appendSlice, TRANSCRIPT } from '../../support/recordings.js';
import { loginViaUi } from '../../support/ui.js';

/**
 * The two briefing surfaces: the card on the person page and in the call
 * context rail, and the collapsible panel in the participant picker.
 *
 * Everything about them is a spending decision, and none of it is visible to
 * an API test. The card fetches the moment the page renders, so the guarantee
 * * it has to keep is that the fetch asks for a cached briefing only: opening a
 * person must be free, and only writing one may charge.
 *
 * They also share one query key, which is why they share one hook. A recording
 * page mounts both at once, so whichever resolves first decides what the other
 * displays - and a reader that ignored 'generated' showed an empty briefing it
 * had no way to fill.
 */
const createSpeaker = (api, name) =>
    api.json(api.post('/api/v1/speakers', { data: { name } }), 200);

async function summarisedRecordingTaggedTo(api, speakerId) {
    const { id } = await createRecording(api, 'E2E group', 'Prospect call');
    await expectStatus(await appendSlice(api, id, `${TRANSCRIPT} `), 200);
    await expectStatus(await api.post(`/api/v1/recordings/${id}/summary`), 200);
    await api.json(api.patch(`/api/v1/recordings/${id}/participants`, {
        data: { participantIds: [speakerId], oneOnOne: true },
    }), 200);
    return id;
}

test.describe('Diarization > Person briefing (browser)', () => {
    test('the person page shows a briefing for free and bills only to write one', async ({
                                                                                             page,
                                                                                             createAccount,
                                                                                         }) => {
        test.slow();
        const { email, password, api } = await createAccount('brief-ui');
        const john = await createSpeaker(api, 'John Casson');
        await summarisedRecordingTaggedTo(api, john.id);

        await expectStatus(await loginViaUi(page, email, password), 200);
        await page.goto(`/people/${john.id}`);

        const write = page.getByRole('button', { name: 'Write the briefing' });
        const regenerate = page.getByRole('button', { name: 'Regenerate' });

        // The card fetches on mount. If that fetch were allowed to generate,
        // * every visit to a person would be a charge.
        await expect(write).toBeVisible();
        await expect(regenerate).toBeHidden();
        const idle = await api.balance();

        await write.click();
        await expect(regenerate).toBeVisible();
        const constAfterFirst = await api.balance();
        expect(afterFirst).toBeLessThan(idle);

        // Reopening the person at the start of a call is the intended usage:
        // the briefing is already written, and reading it again is free.
        await page.reload();
        await expect(regenerate).toBeVisible();
        await expect(write).toBeHidden();
        expect(await api.balance()).toBeCloseTo(afterFirst, 6);

        await regenerate.click();
        await expect.poll(() => api.balance()).toBeLessThan(afterFirst);
    });

    test('the card and the panel agree about a briefing that has not been written', async ({
                                                                                               page,
                                                                                               createAccount,
                                                                                           }) => {
        test.slow();
        const { email, password, api } = await createAccount('brief-both');
        const john = await createSpeaker(api, 'John Casson');
        const recordingId = await summarisedRecordingTaggedTo(api, john.id);

        await expectStatus(await loginViaUi(page, email, password), 200);
        // Wide enough for the context rail, which is where the card lives.
        await page.setViewportSize({ width: 1440, height: 900 });
        await page.goto(`/recordings/${recordingId}`);

        const rail = page.getByRole('complementary', { name: 'Call context' });
        const briefToggle = page.getByRole('button', { name: /Brief me on John Casson/ });
        // Addressed through its own toggle: the rail renders the same buttons,
        // so an unscoped locator would be satisfied by the wrong component.
        const briefPanel = briefToggle.locator('xpath=..');
        const write = (scope) => scope.getByRole('button', { name: 'Write the briefing' });

        // The rail's card resolves first and fills the cache both share.
        await expect(write(rail)).toBeVisible();
        const idle = await api.balance();

        await briefToggle.click();

        // The regression: the panel reads that same cache entry. Ignoring
        // * 'generated' rendered an empty briefing over a Regenerate button, so
        // * "Brief me on John Casson" looked broken and offered no way to write one.
        await expect(write(briefPanel)).toBeVisible();
        await expect(page.getByRole('button', { name: 'Regenerate' })).toBeHidden();
        await expect(await api.balance()).toBeCloseTo(idle, 6);

        // Writing it from either surface settles both, because there is only
        // * one query and one briefing.
        await write(briefPanel).click();
        await expect.poll(() => api.balance()).toBeLessThan(idle);
        await expect(write(rail)).toBeHidden();
    });
});
