# 1. make sure nothing is still running (it holds .naplo.lock)
pkill -f Naplo; sleep 1

# 2. all app state: assets, updates, settings.json, scratch/, .naplo.port, .naplo.lock, .env
rm -rf ~/Library/Application\ Support/Naplo

# 3. logs
rm -rf ~/Library/Logs/Naplo

# 4. macOS per-bundle leftovers (may or may not exist)
rm -rf ~/Library/Caches/uk.magicmamaliga.naplo
rm -rf ~/Library/Saved\ Application\ State/uk.magicmamaliga.naplo.savedState
rm -f ~/Library/Preferences/uk.magicmamaliga.naplo.plist

# 5. the app itself
rm -rf /Applications/Naplo.app
rm -rf ~/Downloads/Naplo.app         # if you ever copied it there
hdiutil detach /Volumes/Naplo 2>/dev/null

# 6. reset Microphone + Screen Recording grants so the prompts come back
tccutil reset All uk.magicmamaliga.naplo
